---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import Icon from '../../components/Icon.astro';
import { site, team } from '../../lib/site';

import flotaImg from '../../assets/flota-cozeta.png';
import luisJCuenca from '../../assets/equipo/luis-j-cuenca.jpg';
import danielLainez from '../../assets/equipo/daniel-lainez.jpg';
import luisCuenca from '../../assets/equipo/luis-cuenca.jpg';
import angelesIbanez from '../../assets/equipo/angeles-ibanez.jpg';

const teamPhotos: Record<string, ImageMetadata> = {
  'Luis J. Cuenca': luisJCuenca,
  'Daniel Laínez': danielLainez,
  'Luis Cuenca': luisCuenca,
  'Mª Ángeles Ibáñez': angelesIbanez,
};

const teamIcons: Record<string, string> = {
  Gerente: 'shield',
  Ejecución: 'tools',
  Finanzas: 'chart',
  Proyectos: 'ingenieria',
};

const teamDept: Record<string, string> = {
  Gerente: 'Dirección general',
  Ejecución: 'Departamento de obra',
  Finanzas: 'Administración y finanzas',
  Proyectos: 'Oficina técnica',
};
---

<Layout
  title="Empresa instaladora de gasolineras en Valencia"
  description="Desde 1996 construyendo y legalizando instalaciones de carburantes en Bétera (Valencia). Conoced nuestra historia y al equipo que lleva cada obra."
  breadcrumbs={[{ name: 'Empresa', path: '/empresa/' }]}
>
  <section class="empresa-hero">
    <div class="container empresa-hero-inner">
      <div class="empresa-hero-copy">
        <p class="eyebrow">Quiénes somos</p>
        <h1>Más de 30 años en el sector petrolífero</h1>
        <p class="hero-intro">
          COZETA nació en 1996 en Bétera (Valencia) de la mano de Luis Joaquín Cuenca, con el
          objetivo de dar servicio técnico riguroso a un sector muy regulado y en constante
          evolución.
        </p>
      </div>
      <div class="empresa-hero-media" data-parallax="-0.1" data-parallax-axis="x" data-parallax-clamp="80">
        <Image
          src={flotaImg}
          alt="Dos furgonetas de la flota de COZETA rotuladas con el logotipo corporativo"
          widths={[600, 900]}
          sizes="(max-width: 900px) 100vw, 55vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="empresa-hero-img"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="historia-heading">
    <div class="container historia">
      <p class="eyebrow">Nuestra historia</p>
      <h2 id="historia-heading" class="historia-title">De pequeña instaladora a equipo llave en mano</h2>
      <ol class="timeline">
        <li class="timeline-item">
          <span class="timeline-marker">{site.foundedYear}</span>
          <div class="timeline-body">
            <h3>Fundación en {site.address.city}</h3>
            <p>
              COZETA nace de la mano de {site.founder}, con el objetivo de dar servicio técnico
              riguroso a un sector muy regulado y en constante evolución. Empezamos como una pequeña
              empresa instaladora, acompañando a operadores petrolíferos, cooperativas agrarias,
              puertos deportivos y administraciones en la construcción y legalización de sus
              instalaciones.
            </p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-marker">Trayectoria</span>
          <div class="timeline-body">
            <h3>Un sector en evolución constante</h3>
            <p>
              Nuevas normativas medioambientales, sistemas de pago desatendido, recuperación de
              vapores, controles más estrictos de industria. Hemos ido adaptando nuestro equipo y
              nuestros procesos para seguir dando un servicio fiable.
            </p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-marker">Hoy</span>
          <div class="timeline-body">
            <h3>Equipo técnico propio</h3>
            <p>
              Contamos con equipo técnico propio capaz de asumir proyectos llave en mano de
              cualquier envergadura, sin subcontratar la parte crítica de la obra. Cumplimos los
              plazos y entregamos instalaciones seguras y legalizadas conforme a la ITC MI-IP04
              desde el primer día.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="equipo-heading">
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">Equipo directivo</p>
        <h2 id="equipo-heading">Las personas detrás de COZETA</h2>
      </div>
      <div class="grid grid-4">
        {team.map((member) => (
          <div class="team-card">
            <div class="team-photo">
              <Image
                src={teamPhotos[member.name]}
                alt={`${member.name}, responsable de ${(teamDept[member.role] ?? member.role).toLowerCase()} en COZETA`}
                width={280}
                height={280}
                format="webp"
                quality={80}
                loading="lazy"
              />
              <div class="team-dept" aria-hidden="true">
                <Icon name={teamIcons[member.role] ?? 'shield'} class="icon-md" />
                <span>{teamDept[member.role] ?? member.role}</span>
              </div>
            </div>
            <h3>{member.name}</h3>
            <p>{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="Detrás de cada obra está este equipo"
    text="No subcontratamos la parte crítica: quien firma el proyecto y quien está en obra trabajan aquí. Si queréis, os lo contamos en persona."
    cta="Concertar una visita"
  />
</Layout>

<style>
  .empresa-hero {
    background: var(--color-bg-alt);
    padding-block: var(--space-8) var(--space-7);
    overflow: hidden;
  }

  .empresa-hero-inner {
    display: grid;
    grid-template-columns: 0.85fr 1.3fr;
    gap: var(--space-6);
    align-items: center;
  }

  .empresa-hero-copy,
  .empresa-hero-media {
    min-width: 0;
  }

  .empresa-hero-copy h1 {
    max-width: 16ch;
  }

  .hero-intro {
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .empresa-hero-media {
    position: relative;
    will-change: transform;
  }

  .empresa-hero-media::before {
    content: '';
    position: absolute;
    inset: var(--space-4) -18px -18px var(--space-4);
    background: var(--color-secondary);
    border-radius: var(--radius-lg);
    z-index: 0;
  }

  .empresa-hero-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transform: rotate(-1.4deg);
  }

  @media (min-width: 901px) {
    .empresa-hero-media {
      margin-block-start: calc(-1 * var(--space-7));
      margin-inline-end: calc(-1 * var(--space-8));
    }
  }

  .historia {
    max-width: 68ch;
  }

  .historia .eyebrow {
    margin-bottom: var(--space-2);
  }

  .historia-title {
    margin-bottom: var(--space-5);
  }

  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--color-border);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.9s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .timeline.is-visible::before {
    transform: scaleY(1);
  }

  .timeline-item {
    position: relative;
    padding: 0 0 var(--space-6) var(--space-6);
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.9s ease,
      transform 0.9s ease;
  }

  .timeline.is-visible .timeline-item {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline.is-visible .timeline-item:nth-child(1) {
    transition-delay: 0.25s;
  }

  .timeline.is-visible .timeline-item:nth-child(2) {
    transition-delay: 0.8s;
  }

  .timeline.is-visible .timeline-item:nth-child(3) {
    transition-delay: 1.35s;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.4em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-secondary);
    transform: scale(0);
    transition: transform 0.5s ease;
  }

  .timeline.is-visible .timeline-item::before {
    transform: scale(1);
  }

  .timeline.is-visible .timeline-item:nth-child(1)::before {
    transition-delay: 0.8s;
  }

  .timeline.is-visible .timeline-item:nth-child(2)::before {
    transition-delay: 1.35s;
  }

  .timeline.is-visible .timeline-item:nth-child(3)::before {
    transition-delay: 1.9s;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline::before,
    .timeline-item,
    .timeline-item::before {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
  }

  .timeline-marker {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
  }

  .timeline-body h3 {
    margin-bottom: var(--space-2);
    font-size: 1.1rem;
  }

  .timeline-body p {
    margin: 0;
  }

  .team-card {
    text-align: center;
  }

  .team-photo {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    isolation: isolate;
  }

  .team-photo::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid var(--color-secondary);
    opacity: 0;
    pointer-events: none;
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  .team-dept {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-primary) 82%, transparent);
    color: #fff;
    padding: var(--space-3);
    text-align: center;
    opacity: 0;
  }

  .team-dept span {
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .team-dept :global(.icon-md) {
    width: 22px;
    height: 22px;
  }

  /* El efecto hover (blanco y negro, zoom, anillo y overlay de departamento) solo
     se activa en dispositivos con puntero fino y hover real (ratón), nunca en táctil. */
  @media (hover: hover) and (pointer: fine) {
    .team-photo::after {
      transform: scale(0.85);
      transition:
        opacity 0.4s ease,
        transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .team-card:hover .team-photo::after,
    .team-card:focus-within .team-photo::after {
      opacity: 1;
      transform: scale(1);
    }

    .team-photo img {
      filter: grayscale(0.75) saturate(1);
      transform: scale(1);
      transition:
        filter 0.5s ease,
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
      will-change: transform;
    }

    .team-card:hover .team-photo img,
    .team-card:focus-within .team-photo img {
      filter: grayscale(0) saturate(1.05);
      transform: scale(1.06);
    }

    .team-dept {
      display: flex;
      transform: scale(0.8);
      transition:
        opacity 0.35s ease,
        transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .team-card:hover .team-dept,
    .team-card:focus-within .team-dept {
      opacity: 1;
      transform: scale(1);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .team-photo img,
    .team-dept,
    .team-photo::after {
      transition-duration: 0.01ms !important;
    }
  }

  .team-card h3 {
    margin-bottom: var(--space-1);
  }

  .team-card p {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .empresa-hero-inner {
      grid-template-columns: 1fr;
    }

    .empresa-hero-media {
      order: -1;
    }
  }
</style>

<script>
  const timeline = document.querySelector('.timeline');

  if (timeline) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      timeline.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              timeline.classList.add('is-visible');
              obs.disconnect();
            }
          });
        },
        { threshold: 0.2 }
      );
      observer.observe(timeline);
    }
  }
</script>
