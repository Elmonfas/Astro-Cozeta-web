---
import Icon from './Icon.astro';
import BlueprintMarks from './BlueprintMarks.astro';
import { site, fullAddress, navLinks } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <BlueprintMarks />
  <div class="container footer-grid">
    <div class="footer-brand">
      <img class="footer-logo" src="/logos/cozeta-logo-horizontal-negativo-transparent.svg" alt={site.tradeName} width="1033" height="260" loading="lazy" />
      <p>{site.claim}. Más de 30 años instalando y legalizando puntos de repostaje en toda España.</p>
      <p class="footer-since">Fundada en {site.foundedYear} · {site.address.city} ({site.address.province})</p>
    </div>

    <div class="footer-col">
      <p class="footer-col-title">Navegación</p>
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-col-title">Contacto</p>
      <ul class="footer-contact">
        <li>
          <Icon name="pin" class="icon-sm" />
          <span>{fullAddress}</span>
        </li>
        <li>
          <Icon name="phone" class="icon-sm" />
          <a href={`tel:+34${site.phone}`}>{site.phoneDisplay}</a>
        </li>
        <li>
          <Icon name="mail" class="icon-sm" />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </li>
      </ul>
    </div>

    <div class="footer-col">
      <p class="footer-col-title">Legal</p>
      <ul>
        <li><a href="/aviso-legal/">Aviso legal</a></li>
        <li><a href="/politica-de-privacidad/">Política de privacidad</a></li>
        <li><a href="/politica-de-cookies/">Política de cookies</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <p>&copy; {year} {site.legalName}. Todos los derechos reservados.</p>
      <p class="footer-colophon">CIF {site.cif} · {site.registryInfo}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    overflow: hidden;
    background: var(--color-primary-dark);
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-grid {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1.3fr 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .footer-logo {
    height: 44px;
    width: auto;
    margin-bottom: var(--space-3);
  }

  .footer-brand p {
    color: rgba(255, 255, 255, 0.7);
    max-width: 32ch;
  }

  .footer-since {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.5) !important;
    margin-top: var(--space-3);
  }

  .footer-col-title {
    display: flex;
    align-items: center;
    gap: 0.5em;
    font-family: var(--font-mono);
    font-weight: 500;
    color: var(--color-secondary-light);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-3);
  }

  .footer-col-title::before {
    content: '';
    display: inline-block;
    width: 0.9em;
    height: 1px;
    background: currentColor;
  }

  .footer-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer-col a {
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--color-secondary-light);
    text-decoration: underline;
  }

  .footer-contact li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: rgba(255, 255, 255, 0.75);
  }

  .footer-contact :global(.icon-sm) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-secondary-light);
  }

  .footer-bottom {
    position: relative;
    border-top: 1px solid rgba(255, 255, 255, 0.12);
    padding-block: var(--space-4);
  }

  .footer-bottom-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .footer-bottom p {
    margin: 0;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.55);
  }

  .footer-colophon {
    font-family: var(--font-mono);
    font-size: 0.76rem !important;
  }

  @media (max-width: 860px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }
  }
</style>
