# Copiar a .env  (cp .env.example .env) y rellenar.
# Las variables PUBLIC_* se incrustan en el HTML generado: aquí no debe ir
# nunca nada secreto. Este sitio es 100 % estático y no tiene servidor propio.

# ── Formulario de contacto (Formspree) ─────────────────────────────────────
# ID del formulario. Está en la URL del panel:
#   https://formspree.io/forms/<PUBLIC_FORMSPREE_ID>/submissions
# El destinatario de los avisos NO se configura aquí, sino en:
#   formspree.io/forms/<ID>/settings → Emails
PUBLIC_FORMSPREE_ID=mgaenozq
