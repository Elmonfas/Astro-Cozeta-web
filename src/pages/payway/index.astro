---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import BlueprintMarks from '../../components/BlueprintMarks.astro';
import Product3DViewer from '../../components/Product3DViewer.astro';
import { site } from '../../lib/site';
import iconClassic from '../../assets/payway/modelo-classic.png';
import iconEffective from '../../assets/payway/modelo-effective.png';
import iconNear from '../../assets/payway/modelo-near.png';
import iconEco from '../../assets/payway/modelo-eco.png';

// Contenido de PAYWAY: textos de la web actual de COZETA y material de marca
// facilitado por la empresa. Sin añadidos propios.

const modelos = [
  {
    nombre: 'Classic',
    texto: 'Aceptador de pagos en caja de acero inoxidable, diseñado para trabajar ininterrumpidamente de forma intensiva.',
    icon: iconClassic,
  },
  {
    nombre: 'Effective',
    texto: 'La solución para aceptar pagos en efectivo: los billetes se guardan en caja fuerte tradicional o automatizada, compatible con empresas de recogida de efectivo.',
    icon: iconEffective,
  },
  {
    nombre: 'Near',
    texto: 'Sistema de pago integrado en los propios surtidores, para una operación de pago en pista más fluida.',
    icon: iconNear,
  },
  {
    nombre: 'Eco',
    texto: 'Todas las capacidades de PAYWAY al mínimo coste: el equipo pensado para instalaciones lowcost.',
    icon: iconEco,
  },
];

const incluye = [
  'Pago con tarjeta de crédito, tarjeta propia de fidelización, contactless y efectivo (monedas y billetes)',
  'Interfaz táctil de fácil manejo',
  'Entorno de facturación integrado',
  'Control de pista automático o manual',
  'Gasóleo profesional y bonificado',
  'Control desde smartphone o tablet',
  'Impresora de gran capacidad (más de 4.000 tickets)',
  'Alarmas por correo electrónico ante incidencias',
];

const pilares = [
  {
    titulo: 'Estabilidad',
    texto: 'Pensado para funcionar de forma ininterrumpida, como exige un equipo desatendido. Desarrollado sobre GNU/Linux, con más de 15 años de experiencia del equipo en entornos industriales de alta disponibilidad.',
  },
  {
    titulo: 'Economía',
    texto: 'Un equipo económico de comprar, instalar y mantener, sin costes ocultos.',
  },
  {
    titulo: 'Seguridad',
    texto: 'Sin escritorio, sin puertas traseras ni programas de acceso remoto de terceros: la conexión se hace por una red privada virtual (VPN) propia y cifrada.',
  },
  {
    titulo: 'Sencillez',
    texto: 'Repostar es sencillo para el cliente, manejar la estación es fácil para el propietario, e instalar y poner en marcha el equipo es rápido para nosotros.',
  },
];

const tecnologia = [
  {
    icon: 'pago',
    titulo: 'Pasarela de pagos',
    texto: 'Trabajamos con un proveedor especializado en pagos con tarjeta para la gestión con los bancos, en vez de intentar hacerlo todo nosotros mismos.',
  },
  {
    icon: 'tools',
    titulo: 'Impresora de gran capacidad',
    texto: 'Rollo de papel largo y ticket optimizado. En instalaciones con varios equipos, las impresoras se pueden usar indistintamente entre ellos.',
  },
  {
    icon: 'shield',
    titulo: 'Autochequeo',
    texto: 'El equipo comprueba periódicamente cada dispositivo y, ante un fallo puntual, se reinicia solo, sin intervención humana.',
  },
  {
    icon: 'chart',
    titulo: 'Crédito centralizado',
    texto: 'Si tiene más de una estación, el crédito a clientes se gestiona de forma centralizada en toda la red.',
  },
  {
    icon: 'phone',
    titulo: 'Control remoto seguro',
    texto: 'La comunicación fuera de la red local va cifrada por VPN propia, sin depender de servidores de terceros.',
  },
  {
    icon: 'ingenieria',
    titulo: 'Base GNU/Linux',
    texto: 'Más de 15 años de experiencia del equipo de desarrollo en aplicaciones de alta disponibilidad para entornos industriales y de transporte.',
  },
];

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: 'PAYWAY',
  description: 'Terminales de cobro automático para estaciones de servicio, distribuidos por COZETA en toda España.',
  brand: { '@type': 'Brand', name: 'PAYWAY' },
  manufacturer: { '@type': 'Organization', name: site.legalName },
};
---

<Layout
  title="PAYWAY: terminales de cobro automático para gasolineras"
  description="COZETA distribuye PAYWAY en toda España: terminales de cobro automático con tarjeta, contactless y efectivo, control remoto y cuatro modelos según necesidad."
  breadcrumbs={[{ name: 'PAYWAY', path: '/payway/' }]}
>
  <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  
  <section class="service-hero">
    <BlueprintMarks />
    <div class="container service-hero-inner">
      <div>
        <p class="eyebrow">Productos</p>
        <h1>PAYWAY</h1>
        <p class="hero-intro">
          COZETA distribuye en todo el territorio nacional la línea de terminales de cobro
          automático marca PAYWAY. Los medios de pago automático PAYWAY permiten al propietario de
          una estación de servicio rentabilizar al máximo su inversión y, además, controlar la
          estación desde cualquier parte con cualquier terminal móvil.
        </p>
        <div class="hero-actions">
          <a href="/contacto/" class="btn btn-primary">Pedir información</a>
          <a href={`tel:+34${site.phone}`} class="btn btn-secondary">
            <Icon name="phone" class="icon-sm" /> {site.phoneDisplay}
          </a>
        </div>
      </div>
      <div class="service-hero-media">
        <Product3DViewer
          height="400px"
          modelSrc="/models/payway-classic.glb"
          modelAlt="Terminal PAYWAY Classic de cobro automático en 3D"
          posterIcon="pago"
          cameraCenter={-25}
          cameraRange={20}
        />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="service-content">
        <p>
          Entre las características que diferencian nuestros terminales del resto se encuentra la
          seguridad y la velocidad. Con PAYWAY puede cobrar con tarjeta de crédito, propia de
          fidelización, con contactless y efectivo (monedas y billetes).
        </p>
        <p>
          El software PAYWAY es el más versátil del mercado: le permite la conexión con la estación
          desde cualquier ordenador, tablet o smartphone. Con PAYWAY no necesita tener instalado
          ningún programa complejo que deba mantener o reinstalar cada vez que cambie de ordenador;
          tan solo necesitará un navegador donde conectarse a su servidor.
        </p>
        <p>
          El ERP de gestión de hidrocarburos PAYWAY le permite tener un control absoluto de la
          estación incluso desde un smartphone. Podrá desde realizar un suministro desde cualquier
          sitio, así como emitir las facturas a fin de mes con un solo click de su teléfono.
          Controle su negocio desde cualquier parte y en cualquier momento.
        </p>
        <p>
          Si dispone de tienda en su estación pídanos una demostración de nuestro ERP para tiendas.
        </p>

        <h2>Qué incluye</h2>
        <ul class="check-list">
          {incluye.map((item) => (
            <li>
              <Icon name="check" class="icon-check" />
              <span>{item}</span>
            </li>
          ))}
        </ul>

        <p class="service-cta">
          Si desea más información de nuestros medios de pago PAYWAY envíenos un mensaje pulsando el botón.
        </p>
        <p><a href="/contacto/" class="btn btn-primary">Pedir información</a></p>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="modelos-heading">
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">Un modelo para cada necesidad</p>
        <h2 id="modelos-heading">Cuatro versiones de PAYWAY</h2>
      </div>
      <div class="grid grid-4 modelos-grid">
        {modelos.map((m) => (
          <div class="modelo-card card">
            <span class="modelo-icon"><Image src={m.icon} alt="" height={160} /></span>
            <h3>{m.nombre}</h3>
            <p>{m.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-dark pilares-section" aria-labelledby="pilares-heading">
    <BlueprintMarks />
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">Economía · estabilidad · seguridad · sencillez</p>
        <h2 id="pilares-heading">Por qué PAYWAY funciona sin sorpresas</h2>
      </div>
      <div class="grid grid-4 pilares-grid">
        {pilares.map((p) => (
          <div class="pilar">
            <h3>{p.titulo}</h3>
            <p>{p.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tecnologia-heading">
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">Bajo el capó</p>
        <h2 id="tecnologia-heading">Solución completa para la comercialización de carburantes</h2>
      </div>
      <div class="grid grid-3">
        {tecnologia.map((t) => (
          <div class="tech-card">
            <span class="tech-icon"><Icon name={t.icon} class="icon" /></span>
            <h3>{t.titulo}</h3>
            <p>{t.texto}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-primary-dark);
    color: #fff;
    padding-block: var(--space-7);
  }

  .service-hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-7);
  }

  .service-hero-inner > * {
    min-width: 0;
  }

  .service-hero-media :global(model-viewer) {
    --poster-color: transparent;
  }

  .service-hero h1 {
    color: #fff;
    margin-bottom: var(--space-3);
  }

  .hero-intro {
    max-width: 60ch;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero-actions :global(.icon-sm) {
    width: 18px;
    height: 18px;
  }




  .check-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .check-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
    color: var(--color-text-muted);
  }

  .check-list :global(.icon-check) {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-success);
    margin-top: 2px;
  }






  /* Modelos */
  .modelos-grid {
    align-items: stretch;
  }

  .modelo-card {
    text-align: center;
  }

  .modelo-icon {
    display: inline-flex;
    align-items: flex-end;
    justify-content: center;
    height: 80px;
    margin-bottom: var(--space-3);
  }

  .modelo-icon :global(img) {
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
  }

  .modelo-card h3 {
    margin-bottom: var(--space-2);
  }

  .modelo-card p {
    margin: 0;
    font-size: 0.92rem;
  }

  /* Pilares */
  .pilares-section {
    position: relative;
    overflow: hidden;
    background: var(--color-primary-dark);
  }

  .pilares-grid {
    position: relative;
  }

  .pilar h3 {
    color: #fff;
    margin-bottom: var(--space-2);
    font-size: 1.05rem;
  }

  .pilar p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 0.92rem;
  }

  /* Tecnología */
  .tech-card {
    text-align: center;
  }

  .tech-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  .tech-icon :global(.icon) {
    width: 28px;
    height: 28px;
  }

  .tech-card h3 {
    margin-bottom: var(--space-2);
    font-size: 1.05rem;
  }

  .tech-card p {
    margin: 0;
    font-size: 0.92rem;
  }

  /* Proceso */





  /* FAQ */




  /* Relacionados */






  .service-content {
    max-width: 72ch;
  }

  .service-content :global(h2) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .service-cta {
    margin-top: var(--space-6);
  }

  @media (max-width: 900px) {
    .modelos-grid,
    .pilares-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .service-hero-inner {
      grid-template-columns: 1fr;
    }

    .service-hero-media :global(.product-3d) {
      height: 320px !important;
    }
  }

  @media (max-width: 620px) {
    .modelos-grid,
    .pilares-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
