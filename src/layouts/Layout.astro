---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import MobileCallButton from '../components/MobileCallButton.astro';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  breadcrumbs?: { name: string; path: string }[];
}

const { title, description, noindex = false, breadcrumbs = [] } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <Seo title={title} description={description} noindex={noindex} breadcrumbs={breadcrumbs} />

    {/* Fuentes autoalojadas (ver src/styles/fonts.css). Se precargan las dos
        que pintan el primer texto visible: el cuerpo y los titulares. */}
    <link rel="preload" href="/fonts/inter-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-700.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <MobileCallButton />
    <script>
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const parallaxEls = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

      if (parallaxEls.length && !prefersReducedMotion) {
        // documentTop se mide una sola vez, ANTES de aplicar ningún transform:
        // si midiéramos con getBoundingClientRect() en cada scroll, el propio
        // desplazamiento ya aplicado falsearía la siguiente medición (bucle que
        // anula el efecto casi por completo).
        const items = parallaxEls.map((el) => {
          const rect = el.getBoundingClientRect();
          const clampAttr = el.dataset.parallaxClamp;
          return {
            el,
            speed: parseFloat(el.dataset.parallax ?? '0'),
            axis: el.dataset.parallaxAxis === 'x' ? 'x' : 'y',
            clamp: clampAttr ? parseFloat(clampAttr) : null,
            documentTop: rect.top + window.scrollY,
            height: rect.height,
          };
        });

        let ticking = false;

        function updateParallax() {
          const viewportCenter = window.innerHeight / 2;
          const scrollY = window.scrollY;
          for (const item of items) {
            const viewportTop = item.documentTop - scrollY;
            if (viewportTop + item.height < -400 || viewportTop > window.innerHeight + 400) continue;
            const distance = viewportTop + item.height / 2 - viewportCenter;
            let offset = distance * item.speed;
            if (item.clamp !== null) {
              offset = Math.max(-item.clamp, Math.min(item.clamp, offset));
            }
            item.el.style.transform =
              item.axis === 'x'
                ? `translate3d(${offset.toFixed(1)}px, 0, 0)`
                : `translate3d(0, ${offset.toFixed(1)}px, 0)`;
          }
          ticking = false;
        }

        function onScroll() {
          if (!ticking) {
            requestAnimationFrame(updateParallax);
            ticking = true;
          }
        }

        function recalculate() {
          for (const item of items) {
            item.el.style.transform = '';
            const rect = item.el.getBoundingClientRect();
            item.documentTop = rect.top + window.scrollY;
            item.height = rect.height;
          }
          updateParallax();
        }

        updateParallax();
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', recalculate);
      }
    </script>
  </body>
</html>
