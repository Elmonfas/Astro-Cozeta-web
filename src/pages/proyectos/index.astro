---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';

const proyectos = [
  { img: '/images/proyectos-real/lowcost.jpg', title: 'Estación LOWCOST', tag: 'Gasolineras', desc: 'Construcción llave en mano de estación de servicio desatendida, con doble marquesina, isla accesible y cartelería multilingüe.' },
  { img: '/images/proyectos-real/soex2.jpg', title: 'SOEX 2', tag: 'Gasolineras', desc: 'Estación de servicio 24 horas de un solo surtidor, con totem de precios y pago en efectivo o con tarjeta.' },
  { img: '/images/proyectos-real/autoil-museros.jpg', title: 'Autoil Lowcost Museros', tag: 'Gasolineras', desc: 'Estación de bajo coste con doble isla de repostaje y marquesina sobre pilares, en Museros (Valencia).' },
  { img: '/images/proyectos-real/benzoil.jpg', title: 'Benzoil', tag: 'Gasolineras', desc: 'Estación de servicio con dos islas de repostaje, imagen corporativa integral y suministro 24 horas.' },
  { img: '/images/proyectos-real/dieself.jpg', title: 'Dieself', tag: 'Gasolineras', desc: 'Punto de suministro desatendido junto a nave industrial, con pago con tarjeta y efectivo las 24 horas.' },
  { img: '/images/proyectos-real/gasoprix.jpg', title: 'Gasoprix', tag: 'Gasolineras', desc: 'Estación de servicio en zona comercial, con marquesina de gran formato y totems de precios digitales.' },
  { img: '/images/proyectos-real/cooperativa-sant-josep.jpg', title: 'Cooperativa Sant Josep', tag: 'Consumos propios', desc: 'Punto de repostaje para una cooperativa agraria, con marquesina e islas adaptadas a maquinaria y vehículos de sus socios.' },
];
---

<Layout
  title="Proyectos"
  description="Galería de instalaciones de carburantes ejecutadas por COZETA: gasolineras, gasocentros, puertos, consumos propios y más."
>
  <PageHero
    eyebrow="Obra ejecutada"
    title="Proyectos realizados"
    intro="Una muestra de las instalaciones que hemos diseñado, construido y legalizado en los últimos años."
  />

  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {proyectos.map((p) => (
          <article class="project-card card">
            <div class="project-media">
              <img src={p.img} alt={p.title} width="800" height="600" loading="lazy" data-parallax="0.25" data-parallax-clamp="40" />
            </div>
            <div class="project-body">
              <span class="project-tag">{p.tag}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner title="¿Tenéis un proyecto similar?" text="Contadnos los detalles y os preparamos una propuesta técnica adaptada a vuestra instalación." />
</Layout>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
  }

  .project-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .project-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 39, 64, 0) 55%, rgba(10, 39, 64, 0.3) 100%);
    pointer-events: none;
  }

  .project-media img {
    position: absolute;
    top: -22%;
    left: 0;
    width: 100%;
    height: 144%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    will-change: transform;
  }

  .project-body {
    padding: var(--space-5);
  }

  .project-tag {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
  }

  .project-body h3 {
    margin-bottom: var(--space-2);
  }

  .project-body p {
    margin: 0;
  }
</style>
