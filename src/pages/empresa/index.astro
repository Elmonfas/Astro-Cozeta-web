---
import Layout from '../../layouts/Layout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { site, team } from '../../lib/site';

const teamPhotos: Record<string, string> = {
  'Luis Cuenca': '/images/placeholders/team-luis-cuenca.jpg',
  'Daniel Laínez': '/images/placeholders/team-daniel-lainez.jpg',
  'Begoña Urizar': '/images/placeholders/team-begona-urizar.jpg',
  'Mª Ángeles Ibáñez': '/images/placeholders/team-angeles-ibanez.jpg',
};
---

<Layout
  title="Empresa"
  description="Conoce COZETA: más de 30 años de experiencia en instalaciones de transferencia de carburantes desde Bétera (Valencia). Equipo e historia."
>
  <section class="empresa-hero">
    <div class="container empresa-hero-inner">
      <div class="empresa-hero-copy">
        <p class="eyebrow">Quiénes somos</p>
        <h1>Más de 30 años instalando el sector de los carburantes</h1>
        <p class="hero-intro">
          COZETA nació en 1996 en Bétera (Valencia) de la mano de Luis Joaquín Cuenca, con el
          objetivo de dar servicio técnico riguroso a un sector muy regulado y en constante
          evolución.
        </p>
      </div>
      <div class="empresa-hero-media" data-parallax="-0.1" data-parallax-axis="x" data-parallax-clamp="80">
        <img
          src="/images/placeholders/empresa-flota.png"
          alt="Furgonetas de la flota de COZETA con el logotipo corporativo"
          width="600"
          height="346"
          loading="eager"
          class="empresa-hero-img"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="historia-heading">
    <div class="container historia">
      <p class="eyebrow">Nuestra historia</p>
      <h2 id="historia-heading" class="visually-hidden">Nuestra historia</h2>
      <ol class="timeline">
        <li class="timeline-item">
          <span class="timeline-marker">{site.foundedYear}</span>
          <div class="timeline-body">
            <h3>Fundación en {site.address.city}</h3>
            <p>
              COZETA nace de la mano de {site.founder}, con el objetivo de dar servicio técnico
              riguroso a un sector muy regulado y en constante evolución. Empezamos como una pequeña
              empresa instaladora, acompañando a operadores petrolíferos, cooperativas agrarias,
              puertos deportivos y administraciones en la construcción y legalización de sus
              instalaciones.
            </p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-marker">Trayectoria</span>
          <div class="timeline-body">
            <h3>Un sector en evolución constante</h3>
            <p>
              Nuevas normativas medioambientales, sistemas de pago desatendido, recuperación de
              vapores, controles más estrictos de industria. Hemos ido adaptando nuestro equipo y
              nuestros procesos para seguir dando un servicio fiable.
            </p>
          </div>
        </li>
        <li class="timeline-item">
          <span class="timeline-marker">Hoy</span>
          <div class="timeline-body">
            <h3>Equipo técnico propio</h3>
            <p>
              Contamos con equipo técnico propio capaz de asumir proyectos llave en mano de
              cualquier envergadura, sin subcontratar la parte crítica de la obra. Cumplimos los
              plazos y entregamos instalaciones seguras y legalizadas conforme a la ITC MI-IP04
              desde el primer día.
            </p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="equipo-heading">
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">Equipo directivo</p>
        <h2 id="equipo-heading">Las personas detrás de COZETA</h2>
      </div>
      <div class="grid grid-4">
        {team.map((member) => (
          <div class="team-card">
            <img src={teamPhotos[member.name]} alt={`Foto de ${member.name}`} width="480" height="480" loading="lazy" />
            <h3>{member.name}</h3>
            <p>{member.role}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner />
</Layout>

<style>
  .empresa-hero {
    background: var(--color-bg-alt);
    padding-block: var(--space-8) var(--space-7);
    overflow: hidden;
  }

  .empresa-hero-inner {
    display: grid;
    grid-template-columns: 0.85fr 1.3fr;
    gap: var(--space-6);
    align-items: center;
  }

  .empresa-hero-copy,
  .empresa-hero-media {
    min-width: 0;
  }

  .empresa-hero-copy h1 {
    max-width: 16ch;
  }

  .hero-intro {
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .empresa-hero-media {
    position: relative;
    will-change: transform;
  }

  .empresa-hero-media::before {
    content: '';
    position: absolute;
    inset: var(--space-4) -18px -18px var(--space-4);
    background: var(--color-secondary);
    border-radius: var(--radius-lg);
    z-index: 0;
  }

  .empresa-hero-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transform: rotate(-1.4deg);
  }

  @media (min-width: 901px) {
    .empresa-hero-media {
      margin-block-start: calc(-1 * var(--space-7));
      margin-inline-end: calc(-1 * var(--space-8));
    }
  }

  .historia {
    max-width: 68ch;
  }

  .historia .eyebrow {
    margin-bottom: var(--space-5);
  }

  .timeline {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    width: 1px;
    height: 100%;
    background: var(--color-border);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 1.9s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .timeline.is-visible::before {
    transform: scaleY(1);
  }

  .timeline-item {
    position: relative;
    padding: 0 0 var(--space-6) var(--space-6);
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.9s ease,
      transform 0.9s ease;
  }

  .timeline.is-visible .timeline-item {
    opacity: 1;
    transform: translateY(0);
  }

  .timeline.is-visible .timeline-item:nth-child(1) {
    transition-delay: 0.25s;
  }

  .timeline.is-visible .timeline-item:nth-child(2) {
    transition-delay: 0.8s;
  }

  .timeline.is-visible .timeline-item:nth-child(3) {
    transition-delay: 1.35s;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-item::before {
    content: '';
    position: absolute;
    left: -5px;
    top: 0.4em;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-secondary);
    transform: scale(0);
    transition: transform 0.5s ease;
  }

  .timeline.is-visible .timeline-item::before {
    transform: scale(1);
  }

  .timeline.is-visible .timeline-item:nth-child(1)::before {
    transition-delay: 0.8s;
  }

  .timeline.is-visible .timeline-item:nth-child(2)::before {
    transition-delay: 1.35s;
  }

  .timeline.is-visible .timeline-item:nth-child(3)::before {
    transition-delay: 1.9s;
  }

  @media (prefers-reduced-motion: reduce) {
    .timeline::before,
    .timeline-item,
    .timeline-item::before {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
  }

  .timeline-marker {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
  }

  .timeline-body h3 {
    margin-bottom: var(--space-2);
    font-size: 1.1rem;
  }

  .timeline-body p {
    margin: 0;
  }

  .team-card {
    text-align: center;
  }

  .team-card img {
    width: 140px;
    height: 140px;
    object-fit: cover;
    border-radius: 50%;
    margin: 0 auto var(--space-4);
  }

  .team-card h3 {
    margin-bottom: var(--space-1);
  }

  .team-card p {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 900px) {
    .empresa-hero-inner {
      grid-template-columns: 1fr;
    }

    .empresa-hero-media {
      order: -1;
    }
  }
</style>

<script>
  const timeline = document.querySelector('.timeline');

  if (timeline) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      timeline.classList.add('is-visible');
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              timeline.classList.add('is-visible');
              obs.disconnect();
            }
          });
        },
        { threshold: 0.2 }
      );
      observer.observe(timeline);
    }
  }
</script>
