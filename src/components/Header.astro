---
import Icon from './Icon.astro';
import { site, navLinks, productLinks } from '../lib/site';

const currentPath = Astro.url.pathname;

function isActive(href: string) {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}

const isProductActive = productLinks.some((p) => isActive(p.href));

// El desplegable "Productos" se inserta entre Servicios y Proyectos. Se busca
// cada enlace por href (no por posición) para no depender del orden exacto
// en que estén declarados en navLinks.
const inicio = navLinks.find((l) => l.href === '/')!;
const servicios = navLinks.find((l) => l.href === '/servicios/')!;
const resto = navLinks.filter((l) => l.href !== '/' && l.href !== '/servicios/');
---

<header class="site-header">
  <div class="header-strip">
    <div class="container header-strip-inner">
      <span>Bétera (Valencia) — Instalando desde 1996</span>
      <span class="header-strip-contact">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <a href={`tel:+34${site.phone}`}>{site.phoneDisplay}</a>
      </span>
    </div>
  </div>
  <div class="container header-inner">
    {/* alt vacío a propósito: el enlace ya lleva aria-label, si no el lector
        de pantalla anunciaría el nombre dos veces seguidas. */}
    <a href="/" class="logo" aria-label={`${site.tradeName} — Ir al inicio`}>
      <img src="/logos/cozeta-logo-horizontal.svg" alt="" width="1033" height="260" />
    </a>

    <nav class="main-nav" aria-label="Navegación principal">
      <ul>
        <li>
          <a href={inicio.href} aria-current={isActive(inicio.href) ? 'page' : undefined}>
            <span class="nav-index">01</span>
            {inicio.label}
          </a>
        </li>
        <li>
          <a href={servicios.href} aria-current={isActive(servicios.href) ? 'page' : undefined}>
            <span class="nav-index">02</span>
            {servicios.label}
          </a>
        </li>
        <li class="has-dropdown">
          <button type="button" class="nav-trigger" aria-current={isProductActive ? 'page' : undefined} aria-haspopup="true">
            <span class="nav-index">03</span>
            Productos
            <span class="nav-caret" aria-hidden="true"></span>
          </button>
          <ul class="dropdown-menu">
            {productLinks.map((item) => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
              </li>
            ))}
          </ul>
        </li>
        {resto.map((link, index) => (
          <li>
            <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
              <span class="nav-index">{String(index + 4).padStart(2, '0')}</span>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <a href={`tel:+34${site.phone}`} class="header-phone" aria-label={`Llamar al ${site.phoneDisplay}`}>
        <Icon name="phone" class="icon-sm" />
      </a>
      <a href="/contacto/" class="btn btn-primary btn-sm header-cta">Pedir presupuesto</a>
      <button
        id="menu-toggle"
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger" aria-hidden="true">
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
          <span class="hamburger-bar"></span>
        </span>
        <span class="visually-hidden" id="menu-toggle-label">Abrir menú</span>
      </button>
    </div>
  </div>

  <div id="mobile-nav" class="mobile-nav" data-open="false">
    <ul>
      <li>
        <a href={inicio.href}>{inicio.label}</a>
      </li>
      <li>
        <a href={servicios.href}>{servicios.label}</a>
      </li>
      <li class="mobile-dropdown-item">
        <details class="mobile-dropdown">
          <summary>Productos</summary>
          <ul>
            {productLinks.map((item) => (
              <li><a href={item.href}>{item.label}</a></li>
            ))}
          </ul>
        </details>
      </li>
      {resto.map((link) => (
        <li>
          <a href={link.href}>{link.label}</a>
        </li>
      ))}
      <li>
        <a href={`tel:+34${site.phone}`} class="mobile-nav-phone">
          <Icon name="phone" class="icon-sm" /> {site.phoneDisplay}
        </a>
      </li>
      <li>
        <a href="/contacto/" class="btn btn-primary btn-sm">Pedir presupuesto</a>
      </li>
    </ul>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    box-shadow: 0 0 0 rgba(10, 39, 64, 0);
    transition: box-shadow 0.3s ease;
  }

  .site-header.is-scrolled {
    box-shadow: 0 6px 20px rgba(10, 39, 64, 0.08);
  }

  .header-strip {
    background: var(--color-primary-dark);
  }

  .header-strip-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: rgba(255, 255, 255, 0.6);
  }

  .header-strip-contact {
    display: flex;
    gap: var(--space-4);
  }

  .header-strip a {
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }

  .header-strip a:hover {
    color: var(--color-secondary-light);
    text-decoration: underline;
  }

  .header-inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .logo {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-shrink: 0;
  }

  .logo img {
    height: 40px;
    width: auto;
  }

  /* Hijo directo, no descendiente: con ".main-nav ul" a secas, este mismo
     display:flex se colaba también en la lista anidada del desplegable
     ".dropdown-menu" (que también es un <ul> dentro de .main-nav) y la
     ponía en fila en vez de en columna. */
  .main-nav > ul {
    list-style: none;
    display: flex;
    gap: var(--space-5);
    margin: 0;
    padding: 0;
  }

  .main-nav a {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    text-decoration: none;
    padding: var(--space-2) 0;
    transition: color 0.2s ease;
  }

  .main-nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 2px;
    background: var(--color-secondary);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-index {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.7rem;
    color: var(--color-secondary);
    opacity: 0.75;
  }

  .main-nav a:hover,
  .main-nav a[aria-current='page'] {
    color: var(--color-secondary);
  }

  .main-nav a:hover::after,
  .main-nav a[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* Desplegable "Productos": se abre solo con hover (o con el teclado, vía
     :focus-within al tabular hasta el botón o hasta un enlace de dentro).
     Sin <details> ni JS: una simple transición de opacidad/escala que, al
     ser CSS puro, ya anima igual de bien la apertura que el cierre. */
  .has-dropdown {
    position: relative;
  }

  /* Puente invisible que rellena el hueco entre "Productos" y el panel
     (el "var(--space-2)" del "top" de .dropdown-menu). Sin esto, al bajar
     el ratón desde el botón hacia las opciones, el cursor cruza ese hueco
     -que no pertenece ni al botón ni al panel- y pierde el :hover a mitad
     de camino, cerrando el desplegable antes de poder pulsar nada. */
  .has-dropdown::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    width: max(100%, 190px);
    height: var(--space-2);
  }

  .nav-trigger {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.4em;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--color-text);
    padding: var(--space-2) 0;
    background: none;
    border: none;
    cursor: default;
    transition: color 0.2s ease;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-current='page'] {
    color: var(--color-secondary);
  }

  .nav-caret {
    width: 7px;
    height: 7px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    transition: transform 0.2s ease;
    opacity: 0.7;
  }

  .has-dropdown:hover .nav-caret,
  .has-dropdown:focus-within .nav-caret {
    transform: rotate(-135deg) translateY(1px);
  }

  .dropdown-menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    z-index: 10;
    min-width: 190px;
    margin: 0;
    padding: var(--space-2);
    list-style: none;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    transform-origin: top left;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-6px) scale(0.94);
    transition:
      opacity 0.16s ease,
      transform 0.16s ease,
      visibility 0s linear 0.16s;
  }

  .has-dropdown:hover .dropdown-menu,
  .has-dropdown:focus-within .dropdown-menu {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.22s cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s;
  }

  .dropdown-menu a {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--color-text);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }

  .dropdown-menu a:hover,
  .dropdown-menu a[aria-current='page'] {
    background: var(--color-bg-alt);
    color: var(--color-secondary);
    text-decoration: none;
    transform: translateX(2px);
  }

  /* Los tres enlaces entran en cascada, pero solo al abrir: al cerrar no
     hay contra-cuenta (transition-delay vuelve a 0 en cuanto se deja de
     cumplir :hover/:focus-within), así que el cierre es un único fundido. */
  .dropdown-menu li {
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease;
  }

  .has-dropdown:hover .dropdown-menu li,
  .has-dropdown:focus-within .dropdown-menu li {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .has-dropdown:hover .dropdown-menu li:nth-child(1),
  .has-dropdown:focus-within .dropdown-menu li:nth-child(1) {
    transition-delay: 0.04s;
  }

  .has-dropdown:hover .dropdown-menu li:nth-child(2),
  .has-dropdown:focus-within .dropdown-menu li:nth-child(2) {
    transition-delay: 0.08s;
  }

  .has-dropdown:hover .dropdown-menu li:nth-child(3),
  .has-dropdown:focus-within .dropdown-menu li:nth-child(3) {
    transition-delay: 0.12s;
  }

  @media (prefers-reduced-motion: reduce) {
    .dropdown-menu,
    .dropdown-menu li,
    .has-dropdown:hover .dropdown-menu,
    .has-dropdown:focus-within .dropdown-menu,
    .has-dropdown:hover .dropdown-menu li,
    .has-dropdown:focus-within .dropdown-menu li {
      transition-duration: 0.01ms !important;
      transition-delay: 0s !important;
    }
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .header-phone {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-bg-alt);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .header-phone:hover {
    background: var(--color-secondary);
    text-decoration: none;
  }

  .header-phone :global(.icon-sm) {
    width: 18px;
    height: 18px;
    color: var(--color-secondary);
    transition: color 0.2s ease;
  }

  .header-phone:hover :global(.icon-sm) {
    color: #fff;
  }

  .menu-toggle {
    display: none;
    position: relative;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    background: none;
    border: none;
    border-radius: 50%;
    padding: 0;
    cursor: pointer;
  }

  .menu-toggle::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-secondary);
    transform: scale(0);
    transition: transform 0.45s cubic-bezier(0.65, -0.15, 0.35, 1.25);
  }

  .menu-toggle[aria-expanded='true']::before {
    transform: scale(1);
  }

  .hamburger {
    position: relative;
    z-index: 1;
    width: 22px;
    height: 16px;
    display: inline-block;
  }

  .hamburger-bar {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2.5px;
    border-radius: 2px;
    background: var(--color-primary-dark);
    transition:
      transform 0.35s cubic-bezier(0.65, -0.15, 0.35, 1.25),
      opacity 0.2s ease,
      background-color 0.3s ease,
      top 0.35s ease,
      width 0.25s ease,
      left 0.25s ease;
  }

  .hamburger-bar:nth-child(1) {
    top: 0;
  }

  .hamburger-bar:nth-child(2) {
    top: 7px;
  }

  .hamburger-bar:nth-child(3) {
    top: 14px;
  }

  .menu-toggle:hover:not([aria-expanded='true']) .hamburger-bar:nth-child(1) {
    width: 65%;
  }

  .menu-toggle:hover:not([aria-expanded='true']) .hamburger-bar:nth-child(3) {
    width: 65%;
    left: 35%;
  }

  .menu-toggle[aria-expanded='true'] .hamburger-bar {
    background: #fff;
  }

  .menu-toggle[aria-expanded='true'] .hamburger-bar:nth-child(1) {
    top: 7px;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .hamburger-bar:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }

  .menu-toggle[aria-expanded='true'] .hamburger-bar:nth-child(3) {
    top: 7px;
    transform: rotate(-45deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-toggle::before,
    .hamburger-bar {
      transition-duration: 0.01ms !important;
    }
  }

  .mobile-nav {
    display: none;
  }

  @media (max-width: 860px) {
    .header-strip,
    .main-nav,
    .header-phone,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
    }

    /* visibility: hidden (además de max-height: 0) es lo que saca los enlaces
       del orden de tabulación. Solo con overflow: hidden seguían siendo
       enfocables con teclado estando el menú cerrado e invisible. */
    .mobile-nav {
      display: block;
      max-height: 0;
      overflow: hidden;
      visibility: hidden;
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      transition:
        max-height 0.25s ease,
        visibility 0s linear 0.25s;
    }

    .mobile-nav[data-open='true'] {
      max-height: 520px;
      visibility: visible;
      transition:
        max-height 0.25s ease,
        visibility 0s;
    }

    .mobile-nav ul {
      list-style: none;
      margin: 0;
      padding: var(--space-3) var(--space-4);
      display: flex;
      flex-direction: column;
      gap: var(--space-1);
    }

    /* 44 px de alto mínimo: los enlaces medían 20-21 px, por debajo del
       mínimo de 24 px que pide WCAG 2.2 para áreas táctiles. */
    .mobile-nav a {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--color-text);
      text-decoration: none;
      font-size: 1.05rem;
    }

    .mobile-nav .btn {
      min-height: 44px;
    }

    .mobile-nav-phone {
      display: flex;
      align-items: center;
      gap: var(--space-2);
      color: var(--color-primary-dark) !important;
    }

    .mobile-nav-phone :global(.icon-sm) {
      width: 18px;
      height: 18px;
      color: var(--color-secondary);
    }

    .mobile-dropdown-item {
      padding: 0;
    }

    .mobile-dropdown summary {
      display: flex;
      align-items: center;
      min-height: 44px;
      font-family: var(--font-body);
      font-weight: 600;
      color: var(--color-text);
      font-size: 1.05rem;
      cursor: pointer;
      list-style: none;
    }

    .mobile-dropdown summary::-webkit-details-marker {
      display: none;
    }

    .mobile-dropdown ul {
      list-style: none;
      margin: 0;
      padding: 0 0 var(--space-2) var(--space-4);
      display: flex;
      flex-direction: column;
    }

    .mobile-dropdown ul a {
      min-height: 40px;
      font-size: 0.98rem;
      color: var(--color-text-muted);
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');

  const toggleLabel = document.getElementById('menu-toggle-label');

  if (toggle && mobileNav) {
    const setOpen = (open: boolean) => {
      mobileNav.setAttribute('data-open', String(open));
      toggle.setAttribute('aria-expanded', String(open));
      if (toggleLabel) toggleLabel.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    };

    toggle.addEventListener('click', () => {
      setOpen(mobileNav.getAttribute('data-open') !== 'true');
    });

    mobileNav.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && mobileNav.getAttribute('data-open') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }

  // El desplegable "Productos" se abre con :hover/:focus-within en CSS, sin
  // JS. Lo único que el CSS no puede resolver solo es Escape: si el foco
  // está dentro (navegando con teclado), lo devuelve al botón para que
  // :focus-within deje de cumplirse y el menú se cierre.
  const productsDropdown = document.querySelector<HTMLElement>('.has-dropdown');
  const productsTrigger = productsDropdown?.querySelector<HTMLButtonElement>('.nav-trigger');

  if (productsDropdown && productsTrigger) {
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && productsDropdown.contains(document.activeElement)) {
        productsTrigger.focus();
      }
    });
  }

  const header = document.querySelector('.site-header');

  if (header) {
    const updateScrolled = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    updateScrolled();
    window.addEventListener('scroll', updateScrolled, { passive: true });
  }
</script>
