---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BlueprintMarks from '../components/BlueprintMarks.astro';
import LogoModel3D from '../components/LogoModel3D.astro';
import PaywayViewer from '../components/PaywayViewer.astro';
import Product3DViewer from '../components/Product3DViewer.astro';
import { site, stats, whyCozeta, clientBrands } from '../lib/site';
import { proyectos as proyectosDestacados } from '../lib/proyectos';

const servicios = (await getCollection('servicios')).sort((a, b) => a.data.order - b.data.order);


---

<Layout
  title="Instalaciones de transferencia de carburantes"
  description="Construimos y legalizamos gasolineras, gasocentros y puntos de repostaje desde Bétera (Valencia). Más de 30 años y equipo técnico propio. Pedid presupuesto."
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Instalaciones petrolíferas desde 1996</p>
        <h1>Instalaciones de transferencia de carburantes, hechas para durar y cumplir la normativa</h1>
        <p class="hero-text">
          Diseñamos, construimos y legalizamos gasolineras, gasocentros y puntos de repostaje para
          operadores, flotas y administraciones. Más de 30 años de experiencia técnica al servicio de
          vuestro proyecto.
        </p>
        <div class="hero-actions">
          <a href="/contacto/" class="btn btn-primary">Pedir presupuesto</a>
          <a href="/servicios/" class="text-link">Ver servicios <Icon name="arrow" class="icon-arrow" /></a>
        </div>
      </div>
      <div class="hero-media" data-parallax="-0.22">
        <LogoModel3D />
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-labelledby="marcas-heading">
    <div class="container">
      <p class="eyebrow" id="marcas-heading">Marcas que ya operan con instalaciones COZETA</p>
    </div>
    <div class="trust-marquee">
      <div class="trust-track">
        <ul class="trust-list">
          {clientBrands.map((brand) => (
            <li>{brand}</li>
          ))}
        </ul>
        <ul class="trust-list" aria-hidden="true">
          {clientBrands.map((brand) => (
            <li>{brand}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="trabajo-heading">
    <div class="container">
      <div class="work-grid">
        <div class="work-intro">
          <p class="eyebrow">Cómo trabajamos</p>
          <h2 id="trabajo-heading">Un único interlocutor, de principio a fin</h2>
          <p class="work-intro-text">
            No subcontratamos la parte crítica de la obra ni la tramitación. Un mismo equipo lleva
            vuestro proyecto desde el primer plano hasta el acta de puesta en marcha.
          </p>
          <ol class="reasons-list">
            {whyCozeta.map((item, index) => (
              <li>
                <span class="reason-number">0{index + 1}</span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </div>

        <div class="services-index">
          <p class="eyebrow">Qué hacemos</p>
          <h2 class="services-index-title">Servicios para cada fase de la instalación</h2>
          <ul class="services-list">
            {servicios.map((servicio) => (
              <li>
                <a href={`/servicios/${servicio.id}/`}>
                  <span class="service-list-head">
                    <span class="service-list-name">{servicio.data.shortTitle}</span>
                    <Icon name="arrow" class="icon-arrow" />
                  </span>
                  <span class="service-list-desc">{servicio.data.intro}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="proyectos-heading">
    <div class="container">
      <div class="section-header-row">
        <div>
          <p class="eyebrow">Obra ejecutada</p>
          <h2 id="proyectos-heading">Proyectos destacados</h2>
        </div>
        <a href="/proyectos/" class="text-link">Ver todos los proyectos <Icon name="arrow" class="icon-arrow" /></a>
      </div>

      <div class="projects-explorer">
        <ul class="projects-index-list" id="projects-index">
          {proyectosDestacados.map((p, index) => (
            <li>
              <a
                href="/proyectos/"
                class="projects-index-item"
                class:list={{ 'is-active': index === 0 }}
                data-index={index}
              >
                <span class="index-num">{String(index + 1).padStart(2, '0')}</span>
                <Image src={p.img} alt="" class="index-thumb" width={128} height={128} format="webp" quality={70} loading="lazy" />
                <span class="index-body">
                  <span class="index-name">{p.title}</span>
                  <span class="index-tag">{p.tag}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="projects-preview" aria-hidden="true">
          {proyectosDestacados.map((p, index) => (
            <Image
              src={p.img}
              alt=""
              class="preview-img"
              class:list={{ 'is-active': index === 0 }}
              data-index={index}
              widths={[600, 1050]}
              sizes="(max-width: 900px) 0px, 50vw"
              format="webp"
              quality={72}
              loading={index === 0 ? 'eager' : 'lazy'}
            />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt payway-section" aria-labelledby="payway-heading">
    <div class="container payway-grid">
      <div class="payway-viewer-wrap">
        <PaywayViewer height="360px" />
      </div>
      <div class="payway-copy">
        <p class="eyebrow">Pago desatendido</p>
        <h2 id="payway-heading">Pago desatendido PAYWAY</h2>
        <p>
          Terminales de cobro automático que distribuimos en toda España, en cuatro modelos según
          necesidad: tarjeta, contactless y efectivo, con control desde cualquier móvil.
        </p>
        <a href="/payway/" class="text-link">Ver PAYWAY <Icon name="arrow" class="icon-arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section netoil-section" aria-labelledby="netoil-heading">
    <div class="container netoil-grid">
      <div class="netoil-copy">
        <p class="eyebrow">Control de consumos</p>
        <h2 id="netoil-heading">Netoil</h2>
        <p>
          Controlador de consumos de combustible para vuestra flota: reconocimiento de vehículos
          por llave o tarjeta, con acceso desde cualquier ordenador o móvil sin instalar nada.
        </p>
        <a href="/netoil/" class="text-link">Ver Netoil <Icon name="arrow" class="icon-arrow" /></a>
      </div>
      <div class="netoil-viewer-wrap">
        <Product3DViewer
          height="360px"
          modelSrc="/models/netoil-terminal.glb"
          modelAlt="Terminal Netoil de control de consumos de combustible en 3D"
          posterIcon="flota"
          cameraCenter={25}
          cameraRange={20}
          shadowIntensity={0.4}
          exposure={1.4}
          environmentImage="legacy"
        />
      </div>
    </div>
  </section>

  <section class="section section-dark stats-section" id="stats">
    <BlueprintMarks />
    <div class="container">
      <div class="grid grid-3 stats-grid">
        {stats.map((stat) => (
          <div class="stat">
            <span class="stat-icon"><Icon name={stat.icon} class="icon" /></span>
            <p class="stat-value">
              <span class="stat-number" data-target={stat.target}>0</span><span class="stat-suffix">{stat.suffix}</span>
            </p>
            <p class="stat-label">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section closing">
    <BlueprintMarks />
    <div class="container closing-inner">
      <div class="closing-copy">
        <p class="eyebrow">Hablemos</p>
        <h2>Antes de decidir, hablad con quien va a hacer la obra</h2>
        <p>
          En la primera llamada os atiende un técnico, no un comercial: sabréis si vuestra idea es
          viable, qué normativa os afecta y con qué plazos reales contar.
        </p>
        <a href="/contacto/" class="btn btn-primary">Plantear mi proyecto</a>
      </div>
      <a href={`tel:+34${site.phone}`} class="closing-phone">
        <span class="closing-phone-label">O llamadnos directamente</span>
        <span class="closing-phone-number">{site.phoneDisplay}</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--color-bg-alt);
    padding-block: var(--space-8) var(--space-7);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  /* Evita que el contenido intrínseco (el visor 3D, textos largos) fuerce
     el ancho de la columna 1fr por encima del viewport en móvil. */
  .hero-copy,
  .hero-media,
  .work-intro,
  .services-index,
  .closing-copy,
  .closing-phone {
    min-width: 0;
  }

  .hero-text {
    font-size: 1.1rem;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  /* Entrada del hero: los textos aparecen en cascada y la columna de la derecha
     con un fundido. La media lleva parallax por JS (transform inline), así que
     aquí solo se anima opacity para no pelearse con ese transform. */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .hero-copy .eyebrow,
  .hero-copy h1,
  .hero-text,
  .hero-actions {
    animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-copy .eyebrow {
    animation-delay: 0.05s;
  }

  .hero-copy h1 {
    animation-delay: 0.15s;
  }

  .hero-text {
    animation-delay: 0.32s;
  }

  .hero-actions {
    animation-delay: 0.46s;
  }

  .hero-media {
    animation: hero-fade 1s ease 0.3s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy .eyebrow,
    .hero-copy h1,
    .hero-text,
    .hero-actions,
    .hero-media {
      animation: none;
    }
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-secondary);
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .text-link :global(.icon-arrow) {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .text-link:hover :global(.icon-arrow) {
    transform: translateX(3px);
  }

  .hero-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 320px;
    will-change: transform;
  }

  /* Franja de marcas */
  .trust-strip {
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-5);
  }

  .trust-strip .eyebrow {
    margin-bottom: var(--space-4);
  }

  .trust-marquee {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .trust-track {
    display: flex;
    width: max-content;
    animation: trust-scroll 28s linear infinite;
  }

  .trust-marquee:hover .trust-track {
    animation-play-state: paused;
  }

  @keyframes trust-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .trust-list {
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-6);
    margin: 0;
    padding: 0 var(--space-6) 0 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-track {
      animation: none;
    }

    .trust-marquee {
      overflow: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* Cómo trabajamos + servicios */
  .work-grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: var(--space-9);
  }

  .work-intro-text {
    max-width: 46ch;
    margin-bottom: var(--space-6);
  }

  .reasons-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .reasons-list li {
    display: flex;
    gap: var(--space-4);
  }

  .reason-number {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--color-secondary);
    padding-top: 0.3em;
  }

  .reasons-list h3 {
    margin-bottom: var(--space-1);
    font-size: 1.05rem;
  }

  .reasons-list p {
    margin: 0;
  }

  .services-index {
    border-top: 1px solid var(--color-border);
  }

  .services-index-title {
    font-size: 1.35rem;
    margin-block: var(--space-4) var(--space-2);
  }

  .services-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .services-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .services-list a {
    display: block;
    padding: var(--space-4) 0;
    text-decoration: none;
    color: inherit;
  }

  .service-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .service-list-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--color-primary-dark);
  }

  .services-list a:hover .service-list-name {
    color: var(--color-secondary);
  }

  .services-list :global(.icon-arrow) {
    width: 18px;
    height: 18px;
    color: var(--color-secondary);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .services-list a:hover :global(.icon-arrow) {
    transform: translateX(3px);
  }

  .service-list-desc {
    display: block;
    margin-top: var(--space-1);
    max-width: 48ch;
    color: var(--color-text-muted);
    font-size: 0.94rem;
  }

  /* Proyectos */
  .section-header-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-bottom: var(--space-6);
  }

  .section-header-row .eyebrow {
    margin-bottom: var(--space-2);
  }

  .section-header-row h2 {
    margin: 0;
  }

  .projects-explorer {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: stretch;
    margin-top: var(--space-2);
  }

  .projects-index-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .projects-index-item {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    text-decoration: none;
    color: inherit;
  }

  .projects-index-item:hover {
    text-decoration: none;
  }

  .index-num {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-secondary);
  }

  .index-thumb {
    display: none;
  }

  .index-body {
    display: flex;
    flex-direction: column;
    gap: 0.2em;
  }

  .index-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.8vw, 1.5rem);
    color: var(--color-primary-dark);
    transition: color 0.2s ease;
  }

  .index-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: var(--color-text-muted);
  }

  .projects-index-item:hover .index-name,
  .projects-index-item.is-active .index-name {
    color: var(--color-secondary);
  }

  .projects-preview {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-bg-alt);
  }

  .preview-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
    filter: saturate(0.9) contrast(1.05);
  }

  .preview-img.is-active {
    opacity: 1;
  }

  /* Pago desatendido */
  .payway-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .payway-viewer-wrap,
  .payway-copy {
    min-width: 0;
  }

  .payway-copy p {
    max-width: 42ch;
    margin-bottom: var(--space-4);
  }

  /* Control de consumos Netoil: mismo patrón que PAYWAY pero con la imagen a
     la derecha (el texto va primero en el DOM), para no repetir la misma
     composición dos secciones seguidas. */
  .netoil-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .netoil-copy,
  .netoil-viewer-wrap {
    min-width: 0;
  }

  .netoil-copy p {
    max-width: 42ch;
    margin-bottom: var(--space-4);
  }

  /* Cifras */
  .stats-section {
    position: relative;
    overflow: hidden;
    background: var(--color-primary-dark);
  }

  .stats-grid {
    position: relative;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-5) var(--space-4);
  }

  .stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: var(--color-secondary-light);
    margin-bottom: var(--space-4);
  }

  .stat-icon :global(.icon) {
    width: 26px;
    height: 26px;
  }

  .stat-value {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 3rem);
    color: #fff;
    margin: 0;
  }

  .stat-suffix {
    color: var(--color-secondary-light);
  }

  .stat-label {
    margin: var(--space-2) 0 0;
    color: rgba(255, 255, 255, 0.68);
    font-size: 0.95rem;
  }

  @media (min-width: 621px) {
    .stat {
      position: relative;
    }

    .stat:not(:first-child)::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 1px;
      height: 60%;
      background: rgba(255, 255, 255, 0.14);
    }
  }

  /* Cierre */
  .closing {
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
    background-image: linear-gradient(120deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
  }

  .closing-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-7);
  }

  .closing-copy h2 {
    color: #fff;
    max-width: 20ch;
  }

  .closing-copy p {
    color: rgba(255, 255, 255, 0.82);
    max-width: 42ch;
  }

  .closing-phone {
    text-align: right;
    text-decoration: none;
    color: #fff;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: var(--space-7);
  }

  .closing-phone:hover {
    text-decoration: none;
  }

  .closing-phone-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: var(--space-2);
  }

  .closing-phone-number {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    color: var(--color-secondary-light);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-media {
      order: -1;
    }

    .work-grid {
      grid-template-columns: 1fr;
      gap: var(--space-7);
    }

    .projects-explorer {
      grid-template-columns: 1fr;
    }

    .projects-preview {
      display: none;
    }

    .payway-grid,
    .netoil-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .payway-viewer-wrap,
    .netoil-viewer-wrap {
      order: -1;
    }

    .index-thumb {
      display: block;
      width: 64px;
      height: 64px;
      object-fit: cover;
      border-radius: var(--radius);
      flex-shrink: 0;
      filter: saturate(0.9) contrast(1.05);
    }

    .closing-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .closing-phone {
      text-align: left;
      border-left: none;
      padding-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: var(--space-5);
    }
  }

  @media (max-width: 620px) {
    .index-name {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  const indexItems = document.querySelectorAll<HTMLElement>('.projects-index-item');
  const previewImgs = document.querySelectorAll<HTMLElement>('.preview-img');

  function activateProject(idx: string | undefined) {
    if (idx === undefined) return;
    indexItems.forEach((item) => item.classList.toggle('is-active', item.dataset.index === idx));
    previewImgs.forEach((img) => img.classList.toggle('is-active', img.dataset.index === idx));
  }

  indexItems.forEach((item) => {
    item.addEventListener('mouseenter', () => activateProject(item.dataset.index));
    item.addEventListener('focus', () => activateProject(item.dataset.index));
  });
</script>

<script>
  const DURATION = 1600;

  function easeOutExpo(t: number) {
    return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
  }

  function animateCount(el: HTMLElement) {
    const target = Number(el.dataset.target ?? '0');
    const start = performance.now();

    function tick(now: number) {
      const progress = Math.min((now - start) / DURATION, 1);
      const value = Math.round(target * easeOutExpo(progress));
      el.textContent = String(value);
      if (progress < 1) {
        requestAnimationFrame(tick);
      } else {
        el.textContent = String(target);
      }
    }

    requestAnimationFrame(tick);
  }

  const statsSection = document.getElementById('stats');
  const numbers = document.querySelectorAll<HTMLElement>('.stat-number');

  if (statsSection && numbers.length) {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      numbers.forEach((el) => {
        el.textContent = el.dataset.target ?? '0';
      });
    } else {
      const observer = new IntersectionObserver(
        (entries, obs) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              numbers.forEach((el) => animateCount(el));
              obs.disconnect();
            }
          });
        },
        { threshold: 0.4 }
      );
      observer.observe(statsSection);
    }
  }
</script>
