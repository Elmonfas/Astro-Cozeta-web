---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import { proyectos } from '../../lib/proyectos';
---

<Layout
  title="Gasolineras y estaciones que hemos construido"
  description="Estaciones de servicio, puntos desatendidos y repostaje para cooperativas construidos y legalizados en Valencia. Mirad la obra antes de pedirnos presupuesto."
  breadcrumbs={[{ name: 'Proyectos', path: '/proyectos/' }]}
>
  <PageHero
    eyebrow="Obra ejecutada"
    title="Proyectos realizados"
    intro="Una muestra de las instalaciones que hemos diseñado, construido y legalizado en los últimos años. Todas siguen en servicio."
  />

  <section class="section" aria-labelledby="obra-heading">
    <div class="container">
      <div class="section-header">
        <h2 id="obra-heading">Instalaciones entregadas y en servicio</h2>
        <p>
          Siete obras representativas del tipo de encargo que solemos recibir: estaciones
          desatendidas, puntos de suministro junto a nave industrial y repostaje para cooperativas
          agrarias.
        </p>
      </div>
      <div class="grid grid-3">
        {proyectos.map((p) => (
          <article class="project-card card">
            <div class="project-media">
              <Image
                src={p.img}
                alt={p.alt}
                widths={[400, 700, 1050]}
                sizes="(max-width: 620px) 100vw, (max-width: 900px) 50vw, 33vw"
                format="webp"
                quality={72}
                loading="lazy"
                data-parallax="0.25"
                data-parallax-clamp="40"
              />
            </div>
            <div class="project-body">
              <span class="project-tag">{p.tag}</span>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CtaBanner
    title="¿Tenéis un proyecto parecido entre manos?"
    text="Enviadnos la ubicación y el tipo de instalación que necesitáis y os devolvemos una propuesta técnica adaptada."
    cta="Contar mi proyecto"
  />
</Layout>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
  }

  .project-media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .project-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(10, 39, 64, 0) 55%, rgba(10, 39, 64, 0.3) 100%);
    pointer-events: none;
  }

  .project-media img {
    position: absolute;
    top: -22%;
    left: 0;
    width: 100%;
    height: 144%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
    will-change: transform;
  }

  .project-body {
    padding: var(--space-5);
  }

  .project-tag {
    display: inline-block;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-secondary);
    margin-bottom: var(--space-2);
  }

  .project-body h3 {
    margin-bottom: var(--space-2);
  }

  .project-body p {
    margin: 0;
  }
</style>
