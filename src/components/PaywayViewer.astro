---
import Product3DViewer from './Product3DViewer.astro';
import posterPayway from '../assets/payway-poster.png';

interface Props {
  class?: string;
  height?: string;
}

const { class: className = '', height = '440px' } = Astro.props;
---

<Product3DViewer
  class={className}
  height={height}
  modelSrc="/models/payway-classic.glb"
  modelAlt="Terminal de pago desatendido PAYWAY Classic en 3D"
  poster={posterPayway}
  posterAlt="Terminal de pago desatendido PAYWAY Classic en caja de acero inoxidable"
  cameraCenter={-25}
  cameraRange={20}
/>
