---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import BlueprintMarks from '../components/BlueprintMarks.astro';
import LogoModel3D from '../components/LogoModel3D.astro';
import PaywayViewer from '../components/PaywayViewer.astro';
import Product3DViewer from '../components/Product3DViewer.astro';
import { site, valores, clientBrands } from '../lib/site';
import { getActividades } from '../lib/actividades';

const actividades = await getActividades();
---

<Layout
  title="Instalaciones de transferencia de carburantes"
  description="COZETA, desde 1996: ingeniería, diseño, construcción y mantenimiento de gasolineras, gasocentros y usos propios en Bétera (Valencia)."
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Instalaciones petrolíferas desde 1996</p>
        <h1>Instalaciones de transferencia de carburantes</h1>
        <p class="hero-text">
          Ingeniería, diseño, construcción y mantenimiento de todo tipo de instalaciones de
          trasvase de carburante, como gasolineras, gasocentros y usos propios.
        </p>
        <div class="hero-actions">
          <a href="/contacto/" class="btn btn-primary">Pedir información</a>
          <a href="/servicios/" class="text-link">Ver actividades <Icon name="arrow" class="icon-arrow" /></a>
        </div>
      </div>
      <div class="hero-media" data-parallax="-0.22">
        <LogoModel3D />
      </div>
    </div>
  </section>

  <section class="trust-strip" aria-labelledby="marcas-heading">
    <div class="container">
      <p class="eyebrow" id="marcas-heading">Clientes que ya confían en instalaciones COZETA</p>
    </div>
    <div class="trust-marquee">
      <div class="trust-track">
        <ul class="trust-list">
          {clientBrands.map((brand) => (
            <li>{brand}</li>
          ))}
        </ul>
        <ul class="trust-list" aria-hidden="true">
          {clientBrands.map((brand) => (
            <li>{brand}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="actividades" aria-labelledby="actividades-heading">
    <div class="container">
      <div class="section-header">
        <p class="eyebrow">Nuestras actividades</p>
        <h2 id="actividades-heading">Lo que hacemos</h2>
      </div>
      <ul class="services-list">
        {actividades.map((a) => (
          <li>
            <a href={a.href}>
              <span class="service-list-head">
                <span class="service-list-name">{a.title}</span>
                <Icon name="arrow" class="icon-arrow" />
              </span>
              <span class="service-list-desc">{a.desc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section section-alt payway-section" aria-labelledby="payway-heading">
    <div class="container payway-grid">
      <div class="payway-viewer-wrap">
        <PaywayViewer height="360px" />
      </div>
      <div class="payway-copy">
        <p class="eyebrow">Medios de pago</p>
        <h2 id="payway-heading">PAYWAY</h2>
        <p>
          Contamos con los medios de pago más rápidos y seguros del mercado. COZETA distribuye en
          todo el territorio nacional la línea de terminales de cobro automático marca PAYWAY.
        </p>
        <a href="/payway/" class="text-link">Ver PAYWAY <Icon name="arrow" class="icon-arrow" /></a>
      </div>
    </div>
  </section>

  <section class="section netoil-section" aria-labelledby="netoil-heading">
    <div class="container netoil-grid">
      <div class="netoil-copy">
        <p class="eyebrow">Consumos propios</p>
        <h2 id="netoil-heading">Netoil</h2>
        <p>
          Con nuestros controladores de consumos NETOIL podrá gestionar y llevar un control
          absoluto del consumo de combustible de sus vehículos.
        </p>
        <a href="/netoil/" class="text-link">Ver Netoil <Icon name="arrow" class="icon-arrow" /></a>
      </div>
      <div class="netoil-viewer-wrap">
        <Product3DViewer
          height="360px"
          modelSrc="/models/netoil-terminal.glb"
          modelAlt="Terminal Netoil de control de consumos de combustible en 3D"
          posterIcon="flota"
          cameraCenter={25}
          cameraRange={20}
        />
      </div>
    </div>
  </section>

  <section class="section section-alt" id="empresa" aria-labelledby="quienes-heading">
    <div class="container quienes-grid">
      <div>
        <p class="eyebrow">Quiénes somos</p>
        <h2 id="quienes-heading">Una empresa con un fin bien definido</h2>
        <p class="quienes-text">
          COZETA es una empresa dedicada al sector petrolífero, fundada por Luis Joaquín Cuenca en 1996.
        </p>
        <a href="/empresa/" class="text-link">Conocer la empresa <Icon name="arrow" class="icon-arrow" /></a>
      </div>
      <ul class="valores">
        {valores.map((v) => <li>{v}</li>)}
      </ul>
    </div>
  </section>

  <section class="section closing">
    <BlueprintMarks />
    <div class="container closing-inner">
      <div class="closing-copy">
        <p class="eyebrow">Contacto</p>
        <h2>Contacta con nosotros</h2>
        <a href="/contacto/" class="btn btn-primary">Enviar mensaje</a>
      </div>
      <a href={`tel:+34${site.phone}`} class="closing-phone">
        <span class="closing-phone-label">Teléfono</span>
        <span class="closing-phone-number">{site.phoneDisplay}</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .hero {
    background: var(--color-bg-alt);
    padding-block: var(--space-8) var(--space-7);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-7);
    align-items: center;
  }

  /* Evita que el contenido intrínseco (el visor 3D, textos largos) fuerce
     el ancho de la columna 1fr por encima del viewport en móvil. */
  .hero-copy,
  .hero-media,
  .closing-copy,
  .closing-phone {
    min-width: 0;
  }

  .hero-text {
    font-size: 1.1rem;
    max-width: 52ch;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  /* Entrada del hero: los textos aparecen en cascada y la columna de la derecha
     con un fundido. La media lleva parallax por JS (transform inline), así que
     aquí solo se anima opacity para no pelearse con ese transform. */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(18px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .hero-copy .eyebrow,
  .hero-copy h1,
  .hero-text,
  .hero-actions {
    animation: hero-rise 0.8s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  .hero-copy .eyebrow {
    animation-delay: 0.05s;
  }

  .hero-copy h1 {
    animation-delay: 0.15s;
  }

  .hero-text {
    animation-delay: 0.32s;
  }

  .hero-actions {
    animation-delay: 0.46s;
  }

  .hero-media {
    animation: hero-fade 1s ease 0.3s both;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-copy .eyebrow,
    .hero-copy h1,
    .hero-text,
    .hero-actions,
    .hero-media {
      animation: none;
    }
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--color-secondary);
    text-decoration: none;
  }

  .text-link:hover {
    text-decoration: underline;
  }

  .text-link :global(.icon-arrow) {
    width: 16px;
    height: 16px;
    transition: transform 0.2s ease;
  }

  .text-link:hover :global(.icon-arrow) {
    transform: translateX(3px);
  }

  .hero-media {
    width: 100%;
    aspect-ratio: 4 / 3;
    min-height: 320px;
    will-change: transform;
  }

  /* Franja de marcas */
  .trust-strip {
    border-block: 1px solid var(--color-border);
    padding-block: var(--space-5);
  }

  .trust-strip .eyebrow {
    margin-bottom: var(--space-4);
  }

  .trust-marquee {
    overflow: hidden;
    width: 100%;
    -webkit-mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, black 8%, black 92%, transparent);
  }

  .trust-track {
    display: flex;
    width: max-content;
    animation: trust-scroll 28s linear infinite;
  }

  .trust-marquee:hover .trust-track {
    animation-play-state: paused;
  }

  @keyframes trust-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  .trust-list {
    list-style: none;
    display: flex;
    flex-wrap: nowrap;
    gap: var(--space-6);
    margin: 0;
    padding: 0 var(--space-6) 0 0;
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .trust-track {
      animation: none;
    }

    .trust-marquee {
      overflow: auto;
      -webkit-mask-image: none;
      mask-image: none;
    }
  }

  /* Actividades */
  .services-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    column-gap: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .services-list li {
    border-bottom: 1px solid var(--color-border);
  }

  .services-list a {
    display: block;
    padding: var(--space-4) 0;
    text-decoration: none;
    color: inherit;
  }

  .service-list-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .service-list-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--color-primary-dark);
  }

  .services-list a:hover .service-list-name {
    color: var(--color-secondary);
  }

  .services-list :global(.icon-arrow) {
    width: 18px;
    height: 18px;
    color: var(--color-secondary);
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .services-list a:hover :global(.icon-arrow) {
    transform: translateX(3px);
  }

  .service-list-desc {
    display: block;
    margin-top: var(--space-1);
    max-width: 48ch;
    color: var(--color-text-muted);
    font-size: 0.94rem;
  }

  /* Pago desatendido */
  .payway-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .payway-viewer-wrap,
  .payway-copy {
    min-width: 0;
  }

  .payway-copy p {
    max-width: 42ch;
    margin-bottom: var(--space-4);
  }

  /* Control de consumos Netoil: mismo patrón que PAYWAY pero con la imagen a
     la derecha (el texto va primero en el DOM), para no repetir la misma
     composición dos secciones seguidas. */
  .netoil-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .netoil-copy,
  .netoil-viewer-wrap {
    min-width: 0;
  }

  .netoil-copy p {
    max-width: 42ch;
    margin-bottom: var(--space-4);
  }

  /* Cierre */
  .closing {
    position: relative;
    overflow: hidden;
    background: var(--color-primary);
    background-image: linear-gradient(120deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
  }

  .closing-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-7);
  }

  .closing-copy h2 {
    color: #fff;
    max-width: 20ch;
  }

  .closing-copy p {
    color: rgba(255, 255, 255, 0.82);
    max-width: 42ch;
  }

  .closing-phone {
    text-align: right;
    text-decoration: none;
    color: #fff;
    border-left: 1px solid rgba(255, 255, 255, 0.2);
    padding-left: var(--space-7);
  }

  .closing-phone:hover {
    text-decoration: none;
  }

  .closing-phone-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.65);
    margin-bottom: var(--space-2);
  }

  .closing-phone-number {
    display: block;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.8rem, 3.4vw, 2.6rem);
    color: var(--color-secondary-light);
    white-space: nowrap;
  }

  /* Quiénes somos */
  .quienes-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    align-items: center;
    gap: var(--space-8);
  }

  .quienes-grid > * {
    min-width: 0;
  }

  .quienes-text {
    max-width: 52ch;
    font-size: 1.05rem;
    margin-bottom: var(--space-4);
  }

  .valores {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: flex-end;
  }

  .valores li {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .services-list,
    .quienes-grid {
      grid-template-columns: 1fr;
    }

    .valores {
      justify-content: flex-start;
    }

    .hero-media {
      order: -1;
    }




    .payway-grid,
    .netoil-grid {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .payway-viewer-wrap,
    .netoil-viewer-wrap {
      order: -1;
    }


    .closing-inner {
      grid-template-columns: 1fr;
      text-align: left;
    }

    .closing-phone {
      text-align: left;
      border-left: none;
      padding-left: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      padding-top: var(--space-5);
    }
  }

</style>
