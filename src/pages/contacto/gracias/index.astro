---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import { site } from '../../../lib/site';
---

<Layout
  title="Solicitud enviada"
  description="Hemos recibido vuestra solicitud de presupuesto. Os responderemos lo antes posible."
>
  <PageHero
    eyebrow="Contacto"
    title="Solicitud enviada"
    intro="Gracias por escribirnos. Hemos recibido vuestro mensaje y os responderemos lo antes posible."
  />

  <section class="section">
    <div class="container">
      <div class="gracias-card card">
        <Icon name="check" class="icon-check" />
        <h2>Mensaje recibido</h2>
        <p>
          Nuestro equipo revisará vuestra solicitud y os contactará por email o teléfono en
          cuanto podamos. Si es urgente, también podéis llamarnos directamente.
        </p>
        <div class="gracias-actions">
          <a href="/" class="btn btn-primary">Volver al inicio</a>
          <a href={`tel:+34${site.phone}`} class="btn btn-secondary">
            <Icon name="phone" class="icon-sm" /> {site.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gracias-card {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-7);
  }

  .gracias-card :global(.icon-check) {
    width: 48px;
    height: 48px;
    color: var(--color-success);
    margin-bottom: var(--space-3);
  }

  .gracias-card h2 {
    margin-bottom: var(--space-3);
  }

  .gracias-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .gracias-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .gracias-actions :global(.icon-sm) {
    width: 18px;
    height: 18px;
  }
</style>
