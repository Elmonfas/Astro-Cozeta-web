---
import BlueprintMarks from './BlueprintMarks.astro';

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="page-hero">
  <BlueprintMarks />
  <div class="container">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {intro && <p class="hero-intro">{intro}</p>}
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-primary-dark);
    color: #fff;
    padding-block: var(--space-7);
  }

  .page-hero h1 {
    position: relative;
    color: #fff;
    max-width: 22ch;
  }

  .page-hero .eyebrow,
  .hero-intro {
    position: relative;
  }

  .hero-intro {
    max-width: 60ch;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.82);
  }
</style>
