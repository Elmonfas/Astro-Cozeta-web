---
import Layout from '../../../layouts/Layout.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import { site } from '../../../lib/site';
---

{/* Página de destino tras enviar el formulario sin JavaScript. Con JS, la
    confirmación se muestra en la propia página de contacto. No debe indexarse:
    no aporta nada en buscadores y es contenido mínimo. */}
<Layout
  title="Mensaje enviado"
  description="Hemos recibido su mensaje y le responderemos lo antes posible. Si corre prisa, puede adelantarlo por teléfono."
  noindex
>
  <PageHero
    eyebrow="Contacto"
    title="Mensaje enviado"
    intro="Gracias por escribirnos. Hemos recibido su mensaje y le responderemos lo antes posible."
  />

  <section class="section">
    <div class="container">
      <div class="gracias-card card">
        <Icon name="check" class="icon-check" />
        <h2>Mensaje recibido</h2>
        <p>
          Revisaremos su mensaje y nos pondremos en contacto con usted por email o teléfono. Si el
          asunto es urgente o prefiere adelantarlo por voz, llámenos directamente.
        </p>
        <div class="gracias-actions">
          <a href="/" class="btn btn-primary">Volver al inicio</a>
          <a href={`tel:+34${site.phone}`} class="btn btn-secondary">
            <Icon name="phone" class="icon-sm" /> {site.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .gracias-card {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-7);
  }

  .gracias-card :global(.icon-check) {
    width: 48px;
    height: 48px;
    color: var(--color-success);
    margin-bottom: var(--space-3);
  }

  .gracias-card h2 {
    margin-bottom: var(--space-3);
  }

  .gracias-card p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .gracias-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .gracias-actions :global(.icon-sm) {
    width: 18px;
    height: 18px;
  }
</style>
