---
import Layout from '../../layouts/Layout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import PaywayViewer from '../../components/PaywayViewer.astro';

const incluye = [
  'Terminales de pago desatendido en surtidor (24 horas)',
  'Lectores de tarjetas de flota, bancarias y códigos QR',
  'Integración con el sistema de gestión de la estación',
  'Software de facturación y control de consumos por cliente',
  'Mantenimiento y actualización de los terminales',
  'Formación al personal para la gestión diaria del sistema',
];

const proceso = [
  {
    titulo: 'Diagnóstico del punto de venta',
    texto: 'Revisamos el sistema de gestión actual y el volumen de operaciones para elegir el terminal adecuado.',
  },
  {
    titulo: 'Instalación del hardware',
    texto: 'Montamos los terminales PAYWAY en surtidor o en isla, con la protección adecuada para exterior.',
  },
  {
    titulo: 'Integración de software',
    texto: 'Conectamos el terminal con el sistema de gestión y facturación de la estación.',
  },
  {
    titulo: 'Pruebas y formación',
    texto: 'Verificamos el funcionamiento con distintos medios de pago y formamos al personal en su uso diario.',
  },
];

const faq = [
  {
    pregunta: '¿Se puede combinar el pago desatendido con atención en horario comercial?',
    respuesta: 'Sí, es habitual: el sistema funciona de forma autónoma fuera de horario y el personal puede intervenir manualmente cuando la estación está atendida.',
  },
  {
    pregunta: '¿Es compatible con tarjetas de flotas de otras empresas?',
    respuesta: 'Sí, integramos los principales sistemas de tarjeta de flota del mercado, además de tarjetas bancarias y pago por app.',
  },
  {
    pregunta: '¿Qué pasa si falla el terminal de pago?',
    respuesta: 'Nuestro servicio de mantenimiento incluye soporte ante incidencias para minimizar el tiempo sin servicio de cobro, con piezas de repuesto disponibles para los modelos que instalamos.',
  },
];

const aside = {
  titulo: '¿Qué sistema de gestión usáis?',
  texto: 'De eso depende qué terminal PAYWAY encaja sin rehacer la integración de ventas y existencias que ya tenéis montada.',
  boton: 'Consultar compatibilidad',
};

const cta = {
  titulo: 'Las horas en que la estación está cerrada también venden',
  texto: 'El terminal PAYWAY cobra de noche y en festivos, y sigue permitiendo atención manual en horario comercial.',
  boton: 'Ver opciones de cobro',
};

const relacionados = [
  { href: '/servicios/gasolineras/', icon: 'gasolinera', label: 'Gasolineras y estaciones de servicio' },
  { href: '/mantenimiento/', icon: 'mantenimiento', label: 'Mantenimiento' },
  { href: '/servicios/ingenieria/', icon: 'ingenieria', label: 'Ingeniería y legalizaciones' },
];
---

<Layout
  title="PAYWAY: pago desatendido para estaciones de servicio"
  description="PAYWAY es el terminal de pago desatendido de COZETA: cobro 24 horas en surtidor con tarjeta, flota y app, integrado con vuestro sistema de gestión."
  breadcrumbs={[{ name: 'PAYWAY', path: '/payway/' }]}
>
  <ServiceDetail
    eyebrow="Productos"
    title="PAYWAY"
    intro="Terminal de pago desatendido en caja de acero inoxidable, diseñado para trabajar 24 horas ininterrumpidamente en exterior."
    incluye={incluye}
    proceso={proceso}
    faq={faq}
    aside={aside}
    cta={cta}
    relacionados={relacionados}
  >
    <Fragment slot="media">
      <PaywayViewer height="400px" />
    </Fragment>

    <p>
      PAYWAY es el sistema de cobro automático que instalamos en estaciones de servicio para que
      podáis operar 24 horas sin personal en caja, o complementar la atención habitual con una
      opción de autoservicio para el cliente.
    </p>
    <p>
      Integra tarjetas de flota, tarjetas bancarias y pago por aplicación, conectado con el
      sistema de gestión de la estación para un control de ventas y existencias en tiempo real.
    </p>
  </ServiceDetail>
</Layout>
