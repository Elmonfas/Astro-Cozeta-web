---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { team, valores } from '../../lib/site';

import flotaImg from '../../assets/flota-cozeta.png';
import luisJCuenca from '../../assets/equipo/luis-j-cuenca.jpg';
import danielLainez from '../../assets/equipo/daniel-lainez.jpg';
import luisCuenca from '../../assets/equipo/luis-cuenca.jpg';
import angelesIbanez from '../../assets/equipo/angeles-ibanez.jpg';

const teamPhotos: Record<string, ImageMetadata> = {
  'Luis J. Cuenca': luisJCuenca,
  'Daniel Laínez': danielLainez,
  'Luis Cuenca': luisCuenca,
  'Mª Ángeles Ibáñez': angelesIbanez,
};
---

<Layout
  title="Empresa instaladora de gasolineras en Valencia"
  description="COZETA, fundada por Luis Joaquín Cuenca en 1996: ingeniería, diseño, construcción y mantenimiento de instalaciones de trasvase de carburante en Bétera (Valencia)."
  breadcrumbs={[{ name: 'Empresa', path: '/empresa/' }]}
>
  <section class="empresa-hero">
    <div class="container empresa-hero-inner">
      <div class="empresa-hero-copy">
        <p class="eyebrow">Quiénes somos</p>
        <h1>Una empresa con un fin bien definido</h1>
        <p class="hero-intro">Más de 20 años en el sector petrolífero</p>
      </div>
      <div class="empresa-hero-media" data-parallax="-0.1" data-parallax-axis="x" data-parallax-clamp="80">
        <Image
          src={flotaImg}
          alt="Dos furgonetas de la flota de COZETA rotuladas con el logotipo corporativo"
          widths={[600, 900]}
          sizes="(max-width: 900px) 100vw, 55vw"
          format="webp"
          quality={80}
          loading="eager"
          fetchpriority="high"
          class="empresa-hero-img"
        />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="quienes-heading">
    <div class="container quienes">
      <h2 id="quienes-heading" class="visually-hidden">Quiénes somos</h2>
      <p>
        COZETA es una empresa dedicada al sector petrolífero, fundada por Luis Joaquín Cuenca en
        1996. Abarca desde la ingeniería, el diseño, la construcción y el mantenimiento de todo
        tipo de instalaciones de trasvase de carburante, como gasolineras, gasocentros, usos
        propios y todo tipo de actividades relacionadas con los hidrocarburos. Hemos dedicado más
        de dos décadas a ofrecer asesoramiento y soluciones a las principales empresas del sector.
      </p>
      <ul class="valores">
        {valores.map((v) => <li>{v}</li>)}
      </ul>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="equipo-heading">
    <div class="container">
      <div class="section-header center">
        <p class="eyebrow">Los responsables de la empresa</p>
        <h2 id="equipo-heading">Los profesionales adecuados son la clave del éxito</h2>
      </div>
      <div class="grid grid-4">
        {team.map((member) => (
          <div class="team-card">
            <div class="team-photo">
              <Image
                src={teamPhotos[member.name]}
                alt={`${member.name}, ${member.role}`}
                width={280}
                height={280}
                format="webp"
                quality={80}
                loading="lazy"
              />
            </div>
            <h3>{member.name}</h3>
            <p class="team-role">{member.role}</p>
            <p class="team-detail">{member.detail}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container empresa-cta">
      <p>Contacta con nosotros</p>
      <a href="/contacto/" class="btn btn-primary">Enviar mensaje</a>
    </div>
  </section>
</Layout>

<style>
  .empresa-hero {
    background: var(--color-bg-alt);
    padding-block: var(--space-8) var(--space-7);
    overflow: hidden;
  }

  .empresa-hero-inner {
    display: grid;
    grid-template-columns: 0.85fr 1.3fr;
    gap: var(--space-6);
    align-items: center;
  }

  .empresa-hero-copy,
  .empresa-hero-media {
    min-width: 0;
  }

  .empresa-hero-copy h1 {
    max-width: 16ch;
  }

  .hero-intro {
    font-size: 1.05rem;
    max-width: 46ch;
  }

  .empresa-hero-media {
    position: relative;
    will-change: transform;
  }

  .empresa-hero-media::before {
    content: '';
    position: absolute;
    inset: var(--space-4) -18px -18px var(--space-4);
    background: var(--color-secondary);
    border-radius: var(--radius-lg);
    z-index: 0;
  }

  .empresa-hero-img {
    position: relative;
    z-index: 1;
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    transform: rotate(-1.4deg);
  }

  @media (min-width: 901px) {
    .empresa-hero-media {
      margin-block-start: calc(-1 * var(--space-7));
      margin-inline-end: calc(-1 * var(--space-8));
    }
  }

  .quienes {
    max-width: 72ch;
  }

  .quienes p {
    font-size: 1.1rem;
  }

  .valores {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .valores li {
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-primary-dark);
  }

  .team-card {
    text-align: center;
  }

  .team-photo {
    position: relative;
    width: 140px;
    height: 140px;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    isolation: isolate;
  }

  .team-photo::after {
    content: '';
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 1.5px solid var(--color-secondary);
    opacity: 0;
    pointer-events: none;
  }

  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  /* Efecto hover solo con puntero fino (ratón), nunca en táctil. */
  @media (hover: hover) and (pointer: fine) {
    .team-photo::after {
      transform: scale(0.85);
      transition:
        opacity 0.4s ease,
        transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .team-card:hover .team-photo::after {
      opacity: 1;
      transform: scale(1);
    }

    .team-photo img {
      filter: grayscale(0.75);
      transition:
        filter 0.5s ease,
        transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }

    .team-card:hover .team-photo img {
      filter: grayscale(0) saturate(1.05);
      transform: scale(1.06);
    }
  }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: reduce) {
    .team-photo img,
    .team-photo::after {
      transition-duration: 0.01ms !important;
    }
  }

  .team-card h3 {
    margin-bottom: var(--space-1);
  }

  .team-role {
    margin: 0;
    font-family: var(--font-body);
    font-weight: 600;
    color: var(--color-secondary);
    font-size: 0.9rem;
  }

  .team-detail {
    margin: var(--space-1) 0 0;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  .empresa-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .empresa-cta p {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.35rem;
    color: var(--color-primary-dark);
  }

  @media (max-width: 900px) {
    .empresa-hero-inner {
      grid-template-columns: 1fr;
    }

    .empresa-hero-media {
      order: -1;
    }
  }
</style>
