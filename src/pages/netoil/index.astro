---
// Página placeholder: pendiente de contenido y fotos reales. noindex + fuera
// del sitemap (ver astro.config.mjs) hasta que se rellene con información real.
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../lib/site';
---

<Layout
  title="Netoil"
  description="Página de Netoil en preparación."
  noindex
>
  <PageHero
    eyebrow="Productos"
    title="Netoil"
    intro="Estamos preparando esta página con fotos e información del proyecto. Mientras tanto, escribidnos si queréis saber más."
  />

  <section class="section">
    <div class="container">
      <div class="coming-soon card">
        <Icon name="clock" class="icon-clock" />
        <h2>Contenido en preparación</h2>
        <p>
          Todavía no tenemos las fotos ni el detalle listos para esta página. En cuanto estén
          disponibles, la completaremos igual que el resto de proyectos y productos de COZETA.
        </p>
        <div class="coming-soon-actions">
          <a href="/contacto/" class="btn btn-primary">Contactar con nosotros</a>
          <a href={`tel:+34${site.phone}`} class="btn btn-secondary">
            <Icon name="phone" class="icon-sm" /> {site.phoneDisplay}
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .coming-soon {
    max-width: 560px;
    margin-inline: auto;
    text-align: center;
    padding: var(--space-7);
  }

  .coming-soon :global(.icon-clock) {
    width: 44px;
    height: 44px;
    color: var(--color-secondary);
    margin-bottom: var(--space-3);
  }

  .coming-soon h2 {
    margin-bottom: var(--space-3);
  }

  .coming-soon p {
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
  }

  .coming-soon-actions {
    display: flex;
    gap: var(--space-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .coming-soon-actions :global(.icon-sm) {
    width: 18px;
    height: 18px;
  }
</style>
