---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getActividades } from '../../lib/actividades';

const actividades = await getActividades();
---

<Layout
  title="Actividades: instalaciones de carburantes en Valencia"
  description="Gasolineras, ingeniería, mantenimiento, medios de pago, consumos propios, gasocentros y puertos. COZETA, instalaciones petrolíferas en Bétera (Valencia)."
  breadcrumbs={[{ name: 'Actividades', path: '/servicios/' }]}
>
  <PageHero
    eyebrow="Actividades"
    title="Nuestras actividades"
    intro="Desde la ingeniería y el diseño hasta la construcción y el mantenimiento de todo tipo de instalaciones de trasvase de carburante."
  />

  <section class="section" aria-label="Actividades de COZETA">
    <div class="container">
      <div class="grid grid-3">
        {actividades.map((a) => (
          <ServiceCard href={a.href} icon={a.icon} title={a.title} description={a.desc} />
        ))}
      </div>
    </div>
  </section>
</Layout>
