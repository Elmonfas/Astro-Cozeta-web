---
// Plantilla de las páginas de actividad (/servicios/[slug]/) y de Netoil.
import Icon from './Icon.astro';
import BlueprintMarks from './BlueprintMarks.astro';
import { site } from '../lib/site';

interface Props {
  eyebrow?: string;
  title: string;
  intro: string;
  icon?: string;
  relacionados?: { href: string; icon: string; label: string }[];
}

const { eyebrow = 'Actividades', title, intro, icon, relacionados = [] } = Astro.props;

const hasMedia = Astro.slots.has('media');

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: title,
  description: intro,
  provider: { '@type': 'LocalBusiness', name: site.legalName, telephone: `+34${site.phone}` },
  areaServed: 'ES',
};
---

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />

<section class="service-hero">
  <BlueprintMarks />
  <div class:list={['container service-hero-inner', hasMedia && 'service-hero-inner-media']}>
    {!hasMedia && icon && <span class="service-hero-icon"><Icon name={icon} class="icon" /></span>}
    <div>
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="hero-intro">{intro}</p>
      <div class="hero-actions">
        <a href="/contacto/" class="btn btn-primary">Pedir información</a>
        <a href={`tel:+34${site.phone}`} class="btn btn-secondary">
          <Icon name="phone" class="icon-sm" /> {site.phoneDisplay}
        </a>
      </div>
    </div>
    {hasMedia && (
      <div class="service-hero-media">
        <slot name="media" />
      </div>
    )}
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="service-content">
      <slot />
      <p class="service-cta">
        <a href="/contacto/" class="btn btn-primary">Pedir información</a>
      </p>
    </div>
  </div>
</section>

{relacionados.length > 0 && (
  <section class="section section-alt" aria-labelledby="relacionados-heading">
    <div class="container">
      <h2 id="relacionados-heading" class="relacionados-title">Otras actividades</h2>
      <ul class="relacionados-list">
        {relacionados.map((r) => (
          <li>
            <a href={r.href}>
              <Icon name={r.icon} class="icon-rel" />
              <strong>{r.label}</strong>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .service-hero {
    position: relative;
    overflow: hidden;
    background: var(--color-primary-dark);
    color: #fff;
    padding-block: var(--space-7);
  }

  .service-hero-inner {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .service-hero-inner-media {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: var(--space-7);
  }

  .service-hero-inner-media > * {
    min-width: 0;
  }

  .service-hero-media :global(model-viewer) {
    --poster-color: transparent;
  }

  .service-hero-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: var(--radius);
    background: rgba(255, 255, 255, 0.1);
    color: var(--color-secondary-light);
    flex-shrink: 0;
  }

  .service-hero-icon :global(.icon) {
    width: 36px;
    height: 36px;
  }

  .service-hero h1 {
    color: #fff;
    margin-bottom: var(--space-3);
  }

  .hero-intro {
    max-width: 60ch;
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.82);
    margin-bottom: var(--space-4);
  }

  .hero-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .hero-actions :global(.icon-sm) {
    width: 18px;
    height: 18px;
  }

  .service-content {
    max-width: 72ch;
  }

  .service-content :global(h2) {
    margin-top: var(--space-6);
    margin-bottom: var(--space-3);
  }

  .service-content :global(h2:first-child) {
    margin-top: 0;
  }

  .service-content :global(ul) {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-5);
    color: var(--color-text-muted);
  }

  .service-content :global(li) {
    margin-bottom: var(--space-1);
  }

  .service-cta {
    margin-top: var(--space-6);
  }

  .relacionados-title {
    font-size: 1.35rem;
    margin-bottom: var(--space-5);
  }

  .relacionados-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
  }

  .relacionados-list a {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 100%;
    padding: var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.2s ease;
  }

  .relacionados-list a:hover {
    border-color: var(--color-secondary);
    text-decoration: none;
  }

  .relacionados-list strong {
    font-family: var(--font-heading);
    font-size: 1rem;
    color: var(--color-primary-dark);
  }

  .relacionados-list :global(.icon-rel) {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    color: var(--color-secondary);
  }

  @media (max-width: 900px) {
    .relacionados-list {
      grid-template-columns: 1fr;
    }

    .service-hero-inner {
      flex-direction: column;
    }

    .service-hero-inner-media {
      grid-template-columns: 1fr;
    }

    .service-hero-media :global(.product-3d) {
      height: 320px !important;
    }
  }
</style>
