---
import Icon from './Icon.astro';
import { site } from '../lib/site';

// title, text y cta son obligatorios a propósito: con valores por defecto, el
// mismo par de frases acababa repetido en las 8 páginas que usan el banner.
interface Props {
  title: string;
  text: string;
  cta: string;
}

const { title, text, cta } = Astro.props;
---

<section class="cta-banner">
  <div class="container cta-inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href="/contacto/" class="btn btn-primary">{cta}</a>
      <a href={`tel:+34${site.phone}`} class="btn btn-secondary">
        <Icon name="phone" class="icon-sm" /> {site.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<style>
  .cta-banner {
    background: var(--color-primary);
    background-image: linear-gradient(120deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
    color: #fff;
    padding-block: var(--space-7);
  }

  .cta-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    flex-wrap: wrap;
  }

  .cta-banner h2 {
    color: #fff;
    margin-bottom: var(--space-2);
  }

  .cta-banner p {
    color: rgba(255, 255, 255, 0.82);
    margin: 0;
    max-width: 46ch;
  }

  .cta-actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .cta-actions :global(.icon-sm) {
    width: 18px;
    height: 18px;
  }
</style>
