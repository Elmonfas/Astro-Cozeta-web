---
import Icon from './Icon.astro';

interface Props {
  href: string;
  icon: string;
  title: string;
  description: string;
  class?: string;
}

const { href, icon, title, description, class: className = '' } = Astro.props;
---

<a href={href} class:list={['service-card card', className]}>
  <span class="service-icon">
    <Icon name={icon} class="icon" />
  </span>
  <h3>{title}</h3>
  <p>{description}</p>
  <span class="service-link">
    Ver servicio <Icon name="arrow" class="icon-arrow" />
  </span>
</a>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    height: 100%;
  }

  .service-card:hover {
    text-decoration: none;
  }

  .service-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius);
    background: var(--color-bg-alt);
    color: var(--color-secondary);
    margin-bottom: var(--space-4);
    transition: background-color 0.25s ease, color 0.25s ease, transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .service-card:hover .service-icon {
    background: var(--color-secondary);
    color: #fff;
    transform: rotate(-6deg) scale(1.08);
  }

  .service-icon :global(.icon) {
    width: 28px;
    height: 28px;
  }

  .service-card h3 {
    margin-bottom: var(--space-2);
  }

  .service-card p {
    flex: 1;
    margin-bottom: var(--space-3);
  }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--color-secondary);
  }

  .service-link :global(.icon-arrow) {
    width: 16px;
    height: 16px;
    transition: transform 0.15s ease;
  }

  .service-card:hover .service-link :global(.icon-arrow) {
    transform: translateX(3px);
  }
</style>
