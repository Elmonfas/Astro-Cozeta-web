---
import { render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import ServiceDetail from '../../../components/ServiceDetail.astro';
import { getCollection } from 'astro:content';
import { getActividades } from '../../../lib/actividades';

export async function getStaticPaths() {
  const servicios = await getCollection('servicios');
  return servicios.map((servicio) => ({
    params: { slug: servicio.id },
    props: { servicio },
  }));
}

const { servicio } = Astro.props;
const { Content } = await render(servicio);
const { title, seoTitle, description, intro, icon } = servicio.data;

const relacionados = (await getActividades())
  .filter((a) => a.href !== `/servicios/${servicio.id}/`)
  .map((a) => ({ href: a.href, icon: a.icon, label: a.title }));
---

<Layout
  title={seoTitle}
  description={description}
  breadcrumbs={[
    { name: 'Actividades', path: '/servicios/' },
    { name: title, path: `/servicios/${servicio.id}/` },
  ]}
>
  <ServiceDetail title={title} intro={intro} icon={icon} relacionados={relacionados}>
    <Content />
  </ServiceDetail>
</Layout>
